###  http://purl.obolibrary.org/obo/BFO_0000050
obo:BFO_0000050 rdf:type owl:ObjectProperty ;
                owl:inverseOf obo:BFO_0000051 ;
                rdf:type owl:TransitiveProperty ;
                obo:IAO_0000115 "a core relation that holds between a part and its whole"@en ;
                rdfs:label "part of"@en .


###  http://purl.obolibrary.org/obo/BFO_0000051
obo:BFO_0000051 rdf:type owl:ObjectProperty ,
                         owl:TransitiveProperty ;
                obo:IAO_0000115 "a core relation that holds between a whole and its part"@en ;
                rdfs:label "has part"@en .


###  http://purl.obolibrary.org/obo/BFO_0000124
obo:BFO_0000124 rdf:type owl:ObjectProperty ;
                owl:inverseOf obo:BFO_0000171 ;
                rdfs:domain [ owl:intersectionOf ( obo:BFO_0000004
                                                   [ rdf:type owl:Class ;
                                                     owl:complementOf obo:BFO_0000006
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
                rdfs:range [ owl:intersectionOf ( obo:BFO_0000004
                                                  [ rdf:type owl:Class ;
                                                    owl:complementOf obo:BFO_0000006
                                                  ]
                                                ) ;
                             rdf:type owl:Class
                           ] ;
                rdfs:label "location of"@en ;
                skos:prefLabel "location of at some time"@en .


###  http://purl.obolibrary.org/obo/BFO_0000171
obo:BFO_0000171 rdf:type owl:ObjectProperty ;
                rdfs:domain [ owl:intersectionOf ( obo:BFO_0000004
                                                   [ rdf:type owl:Class ;
                                                     owl:complementOf obo:BFO_0000006
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
                rdfs:range [ owl:intersectionOf ( obo:BFO_0000004
                                                  [ rdf:type owl:Class ;
                                                    owl:complementOf obo:BFO_0000006
                                                  ]
                                                ) ;
                             rdf:type owl:Class
                           ] ;
                rdfs:label "located in"@en ;
                skos:prefLabel "located in at some time"@en .


###  http://purl.obolibrary.org/obo/IAO_0000136
obo:IAO_0000136 rdf:type owl:ObjectProperty ;
                rdfs:domain obo:IAO_0000030 ;
                obo:IAO_0000115 "A (currently) primitive relation that relates an information artifact to an entity."@en ;
                rdfs:label "is about"@en .


###  http://purl.obolibrary.org/obo/IAO_0000219
obo:IAO_0000219 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:IAO_0000136 ;
                owl:inverseOf obo:IAO_0000235 ;
                rdfs:domain obo:IAO_0000030 ;
                rdfs:range obo:BFO_0000001 ;
                obo:IAO_0000115 "A primitive, instance-level, relation obtaining between an information content entity and some portion of reality. Denotation is what happens when someone creates an information content entity E in order to specifically refer to something. The only relation between E and the thing is that E can be used to 'pick out' the thing. This relation connects those two together. Freedictionary.com sense 3: To signify directly; refer to specifically"@en ;
                rdfs:label "denotes"@en .


###  http://purl.obolibrary.org/obo/IAO_0000235
obo:IAO_0000235 rdf:type owl:ObjectProperty ;
                rdfs:domain obo:BFO_0000001 ;
                rdfs:range obo:IAO_0000030 ;
                obo:IAO_0000115 "inverse of the relation 'denotes'"@en ;
                rdfs:label "denoted by"@en .


###  http://purl.obolibrary.org/obo/OBI_0000299
obo:OBI_0000299 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:RO_0000057 ;
                owl:inverseOf obo:OBI_0000312 ;
                rdfs:domain obo:COB_0000035 ;
                obo:IAO_0000115 "The inverse property of is specified output of" ;
                rdfs:label "has specified output"@en .


###  http://purl.obolibrary.org/obo/OBI_0000312
obo:OBI_0000312 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:RO_0000056 ;
                rdfs:range obo:COB_0000035 ;
                obo:IAO_0000115 "A relation between a completely executed planned process and a continuant participating in that process. The presence of the continuant at the end of the process is explicitly specified in the objective specification which the process realizes the concretization of."@en ;
                rdfs:label "is specified output of"@en .


###  http://purl.obolibrary.org/obo/RO_0000052
obo:RO_0000052 rdf:type owl:ObjectProperty ;
               owl:inverseOf obo:RO_0000053 ;
               rdf:type owl:FunctionalProperty ;
               obo:IAO_0000115 "a relation between a specifically dependent continuant (the characteristic) and any other entity (the bearer), in which the characteristic depends on the bearer for its existence."@en ;
               rdfs:label "characteristic of"@en .


###  http://purl.obolibrary.org/obo/RO_0000053
obo:RO_0000053 rdf:type owl:ObjectProperty ,
                        owl:InverseFunctionalProperty ;
               rdfs:range obo:BFO_0000020 ;
               obo:IAO_0000115 "Inverse of characteristic_of"@en ;
               rdfs:label "has characteristic"@en .


###  http://purl.obolibrary.org/obo/RO_0000056
obo:RO_0000056 rdf:type owl:ObjectProperty ;
               owl:inverseOf obo:RO_0000057 ;
               rdfs:domain obo:BFO_0000002 ;
               rdfs:range obo:BFO_0000003 ;
               obo:IAO_0000115 "a relation between a continuant and a process, in which the continuant is somehow involved in the process"@en ;
               rdfs:label "participates in"@en .


###  http://purl.obolibrary.org/obo/RO_0000057
obo:RO_0000057 rdf:type owl:ObjectProperty ;
               rdfs:domain obo:BFO_0000003 ;
               rdfs:range obo:BFO_0000002 ;
               obo:IAO_0000115 "a relation between a process and a continuant, in which the continuant is somehow involved in the process"@en ;
               rdfs:label "has participant"@en .


###  http://purl.obolibrary.org/obo/RO_0000079
obo:RO_0000079 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000052 ;
               owl:inverseOf obo:RO_0000085 ;
               rdfs:domain obo:BFO_0000034 ;
               obo:IAO_0000115 "a relation between a function and an independent continuant (the bearer), in which the function specifically depends on the bearer for its existence"@en ;
               rdfs:label "function of"@en .


###  http://purl.obolibrary.org/obo/RO_0000080
obo:RO_0000080 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000052 ;
               owl:inverseOf obo:RO_0000086 ;
               obo:IAO_0000115 "a relation between a quality and an independent continuant (the bearer), in which the quality specifically depends on the bearer for its existence"@en ;
               rdfs:label "quality of"@en .


###  http://purl.obolibrary.org/obo/RO_0000081
obo:RO_0000081 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000052 ;
               owl:inverseOf obo:RO_0000087 ;
               obo:IAO_0000115 "a relation between a role and an independent continuant (the bearer), in which the role specifically depends on the bearer for its existence"@en ;
               rdfs:label "role of"@en .


###  http://purl.obolibrary.org/obo/RO_0000085
obo:RO_0000085 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000053 ;
               rdfs:domain obo:BFO_0000004 ;
               rdfs:range obo:BFO_0000034 ;
               obo:IAO_0000115 "a relation between an independent continuant (the bearer) and a function, in which the function specifically depends on the bearer for its existence"@en ;
               rdfs:label "has function"@en .


###  http://purl.obolibrary.org/obo/RO_0000086
obo:RO_0000086 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000053 ;
               rdfs:range obo:BFO_0000019 ;
               obo:IAO_0000115 "a relation between an independent continuant (the bearer) and a quality, in which the quality specifically depends on the bearer for its existence"@en ;
               rdfs:label "has quality"@en .


###  http://purl.obolibrary.org/obo/RO_0000087
obo:RO_0000087 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000053 ;
               rdfs:domain obo:BFO_0000004 ;
               rdfs:range obo:BFO_0000023 ;
               obo:IAO_0000115 "a relation between an independent continuant (the bearer) and a role, in which the role specifically depends on the bearer for its existence"@en ;
               rdfs:label "has role"@en .


###  http://purl.obolibrary.org/obo/RO_0000091
obo:RO_0000091 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000053 ;
               owl:inverseOf obo:RO_0000092 ;
               rdfs:domain obo:BFO_0000004 ;
               rdfs:range obo:BFO_0000016 ;
               obo:IAO_0000115 "a relation between an independent continuant (the bearer) and a disposition, in which the disposition specifically depends on the bearer for its existence"@en ;
               rdfs:label "has disposition"@en .


###  http://purl.obolibrary.org/obo/RO_0000092
obo:RO_0000092 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000052 ;
               rdfs:label "disposition of"@en .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000007
ofl:OFL_0000007 rdf:type owl:ObjectProperty ;
                rdfs:domain ofl:OFL_0000004 ;
                rdfs:range obo:BFO_0000040 ;
                rdfs:label "has boundary determined by"@en ,
                           "tem limite determinado por"@pt-br ;
                skos:example "FL_PT23424_Site hasBoundaryDeterminedBy DeckC_Structure"@en ;
                iof-av:firstOrderLogicDefinition "hasBoundaryDeterminedBy(x,y) → FunctionalLocation(x) ∧ MaterialEntity(y) ∧ boundaryOf(x) determinedInRelationTo(y)"@en ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A relation between a functional location and a material entity such that the material entity provides the reference frame that determines the spatial boundaries of the functional location."@en ,
                                                 "Uma relação entre um local de instalação e uma entidade material tal que a entidade material fornece o referencial que determina os limites espaciais do local de instalação."@pt-br ;
                iof-av:semiFormalNaturalLanguageDefinition "if x hasBoundaryDeterminedBy y then x is a FunctionalLocation and y is a MaterialEntity and the spatial boundaries of x are determined in relation to y"@en ;
                iof-av:usageNote "Implements BFO site semantics: site boundaries are determined in relation to material entities but not by coincidence with those entities."@en .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000012
ofl:OFL_0000012 rdf:type owl:ObjectProperty ;
                owl:inverseOf ofl:OFL_0000024 ;
                rdfs:label "has system site part"@en ,
                           "tem parte de sítio do sistema"@pt-br ;
                iof-av:maturity iof-ind:Provisional .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000013
ofl:OFL_0000013 rdf:type owl:ObjectProperty ;
                rdfs:domain iof-constr:MaterialArtifact ;
                rdfs:range ofl:OFL_0000001 ;
                owl:propertyChainAxiom ( ofl:OFL_0000018
                                         [ owl:inverseOf ofl:OFL_0000016
                                         ]
                                       ) ;
                rdfs:label "has tag"@en ,
                           "tem tag"@pt-br ;
                iof-av:explanatoryNote "Esta relação captura a abreviação pragmática industrial onde engenheiros dizem 'válvula XV-23424' para significar 'a válvula atualmente instalada na posição denotada por XV-23424'. A tag não denota o equipamento — denota a posição."@pt-br ,
                                       "This relation captures the industrial pragmatic shorthand where engineers say 'valve XV-23424' to mean 'the valve currently installed at the position denoted by XV-23424'. The tag does not denote the equipment — it denotes the position."@en ;
                iof-av:firstOrderLogicDefinition "hasTag(x,y) ↔ ∃z(FunctionalLocation(z) ∧ installedAt(x,z) ∧ identifiesLocation(y,z))"@en ;
                iof-av:isPrimitive "false"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A derived relation between equipment and an equipment tag such that the equipment is installed at the functional location identified by the tag. This relation is not asserted but entailed through a property chain: equipment is installedAt a FunctionalLocation, and the EquipmentTag identifiesLocation that same FunctionalLocation."@en ,
                                                 "Uma relação derivada entre um equipamento e uma tag de equipamento tal que o equipamento está instalado no local de instalação identificado pela tag. Esta relação não é assertada, mas inferida por uma cadeia de propriedades: o equipamento está installedAt um FunctionalLocation, e a EquipmentTag identifiesLocation o mesmo FunctionalLocation."@pt-br ;
                iof-av:semiFormalNaturalLanguageDefinition "if x hasTag y then there exists a FunctionalLocation z such that x installedAt z and y identifiesLocation z"@en .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000014
ofl:OFL_0000014 rdf:type owl:ObjectProperty ;
                rdfs:domain ofl:OFL_0000031 ;
                rdfs:range iof-constr:MaterialArtifact ;
                rdfs:label "hospedado por"@pt-br ,
                           "hosted by"@en ;
                skos:example "Sensor PT-23424 hostedBy Valve XV-22342"@en ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A relation between a sensor and an equipment item such that the sensor is physically mounted on the equipment item. The sensor has its own functional location but is physically hosted by the equipment."@en ,
                                                 "Uma relação entre um sensor e um item de equipamento tal que o sensor está fisicamente montado no item de equipamento. O sensor tem seu próprio local de instalação, mas é fisicamente hospedado pelo equipamento."@pt-br .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000015
ofl:OFL_0000015 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:IAO_0000219 ;
                rdf:type owl:FunctionalProperty ;
                rdfs:domain ofl:OFL_0000005 ;
                rdfs:range ofl:OFL_0000004 ;
                rdfs:label "identifica"@pt-br ,
                           "identifies"@en ;
                iof-av:firstOrderLogicDefinition "identifies(x,y) → FunctionalLocationCode(x) ∧ FunctionalLocation(y) ∧ denotes(x,y) ∧ ∀z(identifies(x,z) → z = y)"@en ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A relation between a functional location code and a functional location such that the code uniquely denotes the functional location within the organizational hierarchy following the ISO 14224 coding scheme."@en ,
                                                 "Uma relação entre um código de local de instalação e um local de instalação tal que o código denota unicamente o local de instalação dentro da hierarquia organizacional seguindo o esquema de codificação ISO 14224."@pt-br ;
                iof-av:semiFormalNaturalLanguageDefinition "if x identifies y then x is a FunctionalLocationCode and y is a FunctionalLocation and x uniquely denotes y"@en .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000016
ofl:OFL_0000016 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:IAO_0000219 ;
                rdf:type owl:FunctionalProperty ;
                rdfs:domain ofl:OFL_0000001 ;
                rdfs:range ofl:OFL_0000004 ;
                rdfs:label "identifica local de instalação"@pt-br ,
                           "identifies location"@en ;
                iof-av:explanatoryNote "CRITICAL DESIGN DECISION: The equipment tag denotes the functional location (the position), NOT the physical equipment. The relationship between tag and equipment is mediated through the site via the hasTag property chain."@en ,
                                       "DECISÃO DE PROJETO CRÍTICA: A tag de equipamento denota o local de instalação (a posição), NÃO o equipamento físico. A relação entre tag e equipamento é mediada pelo sítio através da cadeia de propriedades hasTag."@pt-br ;
                iof-av:firstOrderLogicDefinition "identifiesLocation(x,y) → EquipmentTag(x) ∧ FunctionalLocation(y) ∧ denotes(x,y) ∧ ∀z(identifiesLocation(x,z) → z = y)"@en ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A relation between an equipment tag and a functional location such that the tag uniquely identifies the functional location where equipment of the designated type is or can be installed. The tag prefix convention encodes the expected equipment type at the position."@en ,
                                                 "Uma relação entre uma tag de equipamento e um local de instalação tal que a tag identifica unicamente o local de instalação onde equipamento do tipo designado está ou pode ser instalado. A convenção de prefixo da tag codifica o tipo esperado de equipamento na posição."@pt-br ;
                iof-av:semiFormalNaturalLanguageDefinition "if x identifiesLocation y then x is an EquipmentTag and y is a FunctionalLocation and x denotes y"@en .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000017
ofl:OFL_0000017 rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain ofl:OFL_0000036 ;
                rdfs:range ofl:OFL_0000004 ;
                rdfs:label "indexado por sítio"@pt-br ,
                           "indexed by site"@en ;
                rdfs:seeAlso "CQ2: Temporal continuity across replacements"@en ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A relation between a time-stamped measured dataset and a functional location such that the dataset is indexed by the functional location rather than by individual equipment instances, enabling automatic data continuity across equipment replacements."@en ,
                                                 "Uma relação entre um conjunto de dados medidos com carimbo de tempo e um local de instalação tal que o conjunto de dados é indexado pelo local de instalação ao invés de por instâncias individuais de equipamento, permitindo continuidade automática de dados através de substituições de equipamento."@pt-br ;
                iof-av:usageNote "KEY PATTERN: Enables automatic continuity without application logic to 'stitch' data from different equipment instances."@en .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000018
ofl:OFL_0000018 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000171 ;
                rdfs:domain iof-constr:MaterialArtifact ;
                rdfs:range ofl:OFL_0000004 ;
                rdfs:label "instalado em"@pt-br ,
                           "installed at"@en ;
                skos:example "Sensor_PT23424_v2 installedAt FL_PT23424_Site (2017-06-16 to 2022-03-10)"@en ;
                iof-av:firstOrderLogicDefinition "installedAt(x,y) → MaterialArtifact(x) ∧ FunctionalLocation(y) ∧ ∃t(located_in(x,y,t))"@en ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A relation between a piece of equipment and a functional location such that the equipment is physically installed at the functional location during some temporally bounded period. The temporal bounds are captured via installedDate and removedDate data properties."@en ,
                                                 "Uma relação entre uma peça de equipamento e um local de instalação tal que o equipamento está fisicamente instalado no local de instalação durante algum período temporalmente delimitado. Os limites temporais são capturados pelas propriedades de dados installedDate e removedDate."@pt-br ;
                iof-av:semiFormalNaturalLanguageDefinition "if x installedAt y then x is a MaterialArtifact and y is a FunctionalLocation and x is located in y at some time"@en .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000024
ofl:OFL_0000024 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000050 ;
                rdf:type owl:TransitiveProperty ;
                rdfs:domain ofl:OFL_0000004 ;
                rdfs:range ofl:OFL_0000004 ;
                rdfs:label "part of system site"@en ,
                           "parte de sítio do sistema"@pt-br ;
                skos:example "MaintainableItemSite partOfSystemSite EquipmentUnitSite"@en ,
                             "SubsystemSite partOfSystemSite SystemSite"@en ;
                iof-av:firstOrderLogicDefinition "partOfSystemSite(x,y) → FunctionalLocation(x) ∧ FunctionalLocation(y) ∧ partOf(x,y)"@en ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A relation between two functional locations such that the first is a proper part of the second in the ISO 14224 hierarchical decomposition. This relation is transitive, enabling queries across hierarchy levels."@en ,
                                                 "Uma relação entre dois locais de instalação tal que o primeiro é parte própria do segundo na decomposição hierárquica ISO 14224. Esta relação é transitiva, permitindo consultas através dos níveis hierárquicos."@pt-br ;
                iof-av:semiFormalNaturalLanguageDefinition "if x partOfSystemSite y then x is a FunctionalLocation and y is a FunctionalLocation and x is part of y"@en .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000025
ofl:OFL_0000025 rdf:type owl:ObjectProperty ;
                rdfs:domain ofl:OFL_0000021 ;
                rdfs:range ofl:OFL_0000004 ;
                rdfs:label "performed at"@en ,
                           "realizada em"@pt-br ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A relation between a maintenance note and a functional location such that the maintenance note documents work performed at the functional location."@en ,
                                                 "Uma relação entre uma nota de manutenção e um local de instalação tal que a nota de manutenção documenta trabalho realizado no local de instalação."@pt-br .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000029
ofl:OFL_0000029 rdf:type owl:ObjectProperty ;
                rdfs:domain ofl:OFL_0000006 ;
                rdfs:range obo:BFO_0000034 ;
                rdfs:label "requer função"@pt-br ,
                           "requires function"@en ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A relation between a functional location specification and a BFO function such that the specification prescribes that the function must be realized by equipment installed at the associated functional location."@en ,
                                                 "Uma relação entre uma especificação de local de instalação e uma função BFO tal que a especificação prescreve que a função deve ser realizada pelo equipamento instalado no local de instalação associado."@pt-br .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000030
ofl:OFL_0000030 rdf:type owl:ObjectProperty ;
                rdfs:domain ofl:OFL_0000004 ;
                rdfs:range ofl:OFL_0000028 ;
                rdfs:label "requer papel"@pt-br ,
                           "requires role"@en ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A relation between a functional location and a required role such that equipment installed at the functional location must bear the specified role."@en ,
                                                 "Uma relação entre um local de instalação e um papel requerido tal que o equipamento instalado no local de instalação deve portar o papel especificado."@pt-br .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000032
ofl:OFL_0000032 rdf:type owl:ObjectProperty ;
                rdfs:domain ofl:OFL_0000006 ;
                rdfs:range ofl:OFL_0000004 ;
                rdfs:label "especifica local de instalação"@pt-br ,
                           "specifies location"@en ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A relation between a functional location specification and a functional location such that the specification prescribes the required function and technical constraints at the functional location."@en ,
                                                 "Uma relação entre uma especificação de local de instalação e um local de instalação tal que a especificação prescreve a função requerida e as restrições técnicas no local de instalação."@pt-br .


#################################################################
#    Data properties
#################################################################

###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000008
ofl:OFL_0000008 rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain ofl:OFL_0000004 ;
                rdfs:range xsd:double ;
                rdfs:label "has coordinate X"@en ,
                           "tem coordenada X"@pt-br ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "The X coordinate of a functional location relative to a material reference frame."@en .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000009
ofl:OFL_0000009 rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain ofl:OFL_0000004 ;
                rdfs:range xsd:double ;
                rdfs:label "has coordinate Y"@en ,
                           "tem coordenada Y"@pt-br ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "The Y coordinate of a functional location relative to a material reference frame."@en .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000010
ofl:OFL_0000010 rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain ofl:OFL_0000004 ;
                rdfs:range xsd:double ;
                rdfs:label "has coordinate Z"@en ,
                           "tem coordenada Z"@pt-br ;
                skos:example "Z: +12.6m (Deck C level on platform P-74)"@en ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "The Z coordinate (elevation) of a functional location relative to a material reference frame."@en .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000011
ofl:OFL_0000011 rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain ofl:OFL_0000036 ;
                rdfs:range xsd:string ;
                rdfs:label "has series label"@en ,
                           "tem rótulo da série"@pt-br ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A user-facing label for a time series dataset."@en .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000019
ofl:OFL_0000019 rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain iof-constr:MaterialArtifact ;
                rdfs:range xsd:dateTime ;
                rdfs:label "data de instalação"@pt-br ,
                           "installed date"@en ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "O carimbo de tempo de quando o equipamento foi instalado em um local de instalação."@pt-br ,
                                                 "The timestamp when equipment was installed at a functional location."@en .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000022
ofl:OFL_0000022 rdf:type owl:DatatypeProperty ;
                rdfs:domain ofl:OFL_0000021 ;
                rdfs:range xsd:string ;
                rdfs:label "note text"@en ,
                           "texto da nota"@pt-br ;
                iof-av:maturity iof-ind:Provisional .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000023
ofl:OFL_0000023 rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain ofl:OFL_0000021 ;
                rdfs:range xsd:dateTime ;
                rdfs:label "carimbo de tempo da nota"@pt-br ,
                           "note timestamp"@en ;
                iof-av:maturity iof-ind:Provisional .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000027
ofl:OFL_0000027 rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain iof-constr:MaterialArtifact ;
                rdfs:range xsd:dateTime ;
                rdfs:label "data de remoção"@pt-br ,
                           "removed date"@en ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "O carimbo de tempo de quando o equipamento foi removido de um local de instalação. A ausência indica que o equipamento está atualmente instalado."@pt-br ,
                                                 "The timestamp when equipment was removed from a functional location. Absence indicates equipment is currently installed."@en .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000033
ofl:OFL_0000033 rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain ofl:OFL_0000036 ;
                rdfs:range xsd:anyURI ;
                rdfs:label "armazenado em"@pt-br ,
                           "stored at"@en ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "The URI of the storage system where time series data is physically stored."@en .


#################################################################
#    Classes
#################################################################

###  http://purl.obolibrary.org/obo/APOLLO_SV_00000796
obo:APOLLO_SV_00000796 rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( obo:COB_0000035
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty obo:OBI_0000299 ;
                                                                    owl:someValuesFrom obo:IAO_0000100
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:subClassOf obo:COB_0000035 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:OBI_0000299 ;
                                         owl:someValuesFrom obo:IAO_0000100
                                       ] ;
                       obo:IAO_0000115 "A planned process that has a data set as its specified output."@en ;
                       rdfs:label "dataset creating"@en .


###  http://purl.obolibrary.org/obo/BFO_0000001
obo:BFO_0000001 rdf:type owl:Class ;
                rdfs:label "entity"@en ;
                skos:example "Julius Caesar; the Second World War; your body mass index; Verdi's Requiem"@en ;
                skos:prefLabel "entity"@en .


###  http://purl.obolibrary.org/obo/BFO_0000002
obo:BFO_0000002 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000001 ;
                owl:disjointWith obo:BFO_0000003 ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty obo:BFO_0000050 ;
                                   owl:someValuesFrom obo:BFO_0000003
                                 ] ;
                obo:IAO_0000115 "An entity that exists in full at any time in which it exists at all, persists through time while maintaining its identity and has no temporal parts."@en ;
                rdfs:label "continuant"@en ;
                skos:example "A human being; a tennis ball; a cave; a region of space; someone's temperature"@en ;
                skos:prefLabel "continuant"@en .


###  http://purl.obolibrary.org/obo/BFO_0000003
obo:BFO_0000003 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000001 ;
                owl:disjointWith [ rdf:type owl:Restriction ;
                                   owl:onProperty obo:BFO_0000050 ;
                                   owl:someValuesFrom obo:BFO_0000002
                                 ] ;
                obo:IAO_0000115 "An entity that has temporal parts and that happens, unfolds or develops through time."@en ;
                rdfs:label "occurrent"@en .


###  http://purl.obolibrary.org/obo/BFO_0000004
obo:BFO_0000004 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000002 ;
                owl:disjointWith obo:BFO_0000020 ,
                                 obo:BFO_0000031 ;
                rdfs:label "independent continuant"@en ;
                skos:example "An atom; a molecule; an organism; a heart; a chair; the bottom right portion of a human torso; a leg; the interior of your mouth; a spatial region; an orchestra"@en ;
                skos:prefLabel "independent continuant"@en .


###  http://purl.obolibrary.org/obo/BFO_0000006
obo:BFO_0000006 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000141 ;
                rdfs:label "spatial region"@en ;
                skos:example "As for zero-dimensional spatial region, one-dimensional spatial region, two-dimensional spatial region, three-dimensional spatial region"@en ;
                skos:prefLabel "spatial region"@en .


###  http://purl.obolibrary.org/obo/BFO_0000015
obo:BFO_0000015 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000003 ;
                rdfs:label "process"@en .


###  http://purl.obolibrary.org/obo/BFO_0000016
obo:BFO_0000016 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000017 ;
                owl:disjointWith obo:BFO_0000023 ;
                rdfs:label "disposition"@en ;
                skos:altLabel "internally-grounded realizable entity"@en ;
                skos:example "An atom of element X has the disposition to decay to an atom of element Y; the cell wall is disposed to transport cellular material through endocytosis and exocytosis; certain people have a predisposition to colon cancer; children are innately disposed to categorize objects in certain ways"@en ;
                skos:prefLabel "disposition"@en .


###  http://purl.obolibrary.org/obo/BFO_0000017
obo:BFO_0000017 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000020 ;
                owl:disjointWith obo:BFO_0000019 ;
                obo:IAO_0000115 "A specifically dependent continuant  that inheres in continuant  entities and are not exhibited in full at every time in which it inheres in an entity or group of entities. The exhibition or actualization of a realizable entity is a particular manifestation, functioning or process that occurs under certain circumstances."@en ;
                rdfs:label "realizable entity"@en ;
                skos:example "The role of being a doctor; the role of this boundary to delineate where Utah and Colorado meet; the function of your reproductive organs; the disposition of your blood to coagulate; the disposition of this piece of metal to conduct electricity"@en ;
                skos:prefLabel "realizable entity"@en .


###  http://purl.obolibrary.org/obo/BFO_0000019
obo:BFO_0000019 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000020 ;
                rdfs:label "quality"@en .


###  http://purl.obolibrary.org/obo/BFO_0000020
obo:BFO_0000020 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000002 ;
                owl:disjointWith obo:BFO_0000031 ;
                rdfs:label "specifically dependent continuant"@en ;
                skos:example "(with multiple bearers) John's love for Mary; the ownership relation between John and this statue; the relation of authority between John and his subordinates"@en ,
                             "(with one bearer) The mass of this tomato; the pink colour of a medium rare piece of grilled filet mignon at its centre; the smell of this portion of mozzarella; the disposition of this fish to decay; the role of being a doctor; the function of this heart to pump blood; the shape of this hole"@en ;
                skos:prefLabel "specifically dependent continuant"@en .


###  http://purl.obolibrary.org/obo/BFO_0000023
obo:BFO_0000023 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000017 ;
                obo:IAO_0000115 "A realizable entity  the manifestation of which brings about some result or end that is not essential to a continuant  in virtue of the kind of thing that it is but that can be served or participated in by that kind of continuant  in some kinds of natural, social or institutional contexts."@en ;
                rdfs:label "role"@en ;
                skos:altLabel "externally-grounded realizable entity"@en ;
                skos:example "The priest role; the student role; the role of subject in a clinical trial; the role of a stone in marking a property boundary; the role of a boundary to demarcate two neighbouring administrative territories; the role of a building in serving as a military target"@en ;
                skos:prefLabel "role"@en .


###  http://purl.obolibrary.org/obo/BFO_0000029
obo:BFO_0000029 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000141 ;
                rdfs:label "site"@en ;
                skos:example "A hole in a portion of cheese; a rabbit hole; the Grand Canyon; the Piazza San Marco; the kangaroo-joey-containing hole of a kangaroo pouch; your left nostril (a fiat part - the opening - of your left nasal cavity); the lumen of your gut; the hold of a ship; the interior of the trunk of your car; hole in an engineered floor joist"@en ,
                             "location of a container, floor area in a factory building, location of a machine (relative to the coordinate of a factory floor), location on a shelf in a warehouse"@en-us ;
                skos:prefLabel "site"@en .


###  http://purl.obolibrary.org/obo/BFO_0000031
obo:BFO_0000031 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000002 ;
                rdfs:label "generically dependent continuant"@en ;
                skos:altLabel "g-dependent continuant"@en ;
                skos:example "The pdf file on your laptop; the pdf file that is a copy thereof on my laptop; the sequence of this protein molecule; the sequence that is a copy thereof in that protein molecule; the content that is shared by a string of dots and dashes written on a page and the transmitted Morse code signal; the content of a sentence; an engineering blueprint"@en ;
                skos:prefLabel "generically dependent continuant"@en .


###  http://purl.obolibrary.org/obo/BFO_0000034
obo:BFO_0000034 rdf:type owl:Class ;
                rdfs:subClassOf <https://spec.industrialontologies.org/ontology/core/Core/Capability> ;
                rdfs:label "function"@en ;
                skos:example "The function of a hammer to drive in nails; the function of a heart pacemaker to regulate the beating of a heart through electricity"@en ;
                skos:prefLabel "function"@en .


###  http://purl.obolibrary.org/obo/BFO_0000040
obo:BFO_0000040 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000004 ;
                owl:disjointWith obo:BFO_0000141 ;
                obo:IAO_0000115 "An independent continuant that is spatially extended whose identity is independent of that of other entities and can be maintained through time."@en ;
                rdfs:label "material entity"@en ;
                skos:example "A human being; the undetached arm of a human being; an aggregate of human beings"@en ;
                skos:prefLabel "material entity"@en .


###  http://purl.obolibrary.org/obo/BFO_0000140
obo:BFO_0000140 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000141 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000124 ;
                                  owl:allValuesFrom obo:BFO_0000140
                                ] ;
                rdfs:label "continuant fiat boundary"@en ;
                skos:example "As for fiat point, fiat line, fiat surface"@en ;
                skos:prefLabel "continuant fiat boundary"@en .


###  http://purl.obolibrary.org/obo/BFO_0000141
obo:BFO_0000141 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000004 ;
                rdfs:label "immaterial entity"@en ;
                skos:example "As for fiat point, fiat line, fiat surface, site"@en ;
                skos:prefLabel "immaterial entity"@en .


###  http://purl.obolibrary.org/obo/COB_0000035
obo:COB_0000035 rdf:type owl:Class ;
                rdfs:subClassOf obo:COB_0000082 ;
                rdfs:label "completely executed planned process"@en .


###  http://purl.obolibrary.org/obo/COB_0000082
obo:COB_0000082 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000015 ;
                obo:IAO_0000115 "A process that is initiated by an agent who intends to carry out a plan to achieve an objective through one or more actions as described in a plan specification."@en ;
                rdfs:label "planned process"@en .


###  http://purl.obolibrary.org/obo/IAO_0000027
obo:IAO_0000027 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000030 ;
                obo:IAO_0000115 "An information content entity that is intended to be one or more truthful statement(s) about something (modulo, e.g., measurement precision or other systematic errors) and is constructed/acquired by a method which reliably tends to produce (approximately) truthful statements."@en ;
                rdfs:label "data entity"@en .


###  http://purl.obolibrary.org/obo/IAO_0000028
obo:IAO_0000028 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000030 ;
                obo:IAO_0000115 "An information content entity that is a mark(s) or character(s) used as a conventional representation of another entity."@en ;
                rdfs:label "symbol"@en .


###  http://purl.obolibrary.org/obo/IAO_0000030
obo:IAO_0000030 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000031 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:IAO_0000136 ;
                                  owl:someValuesFrom obo:BFO_0000001
                                ] ;
                obo:IAO_0000115 "A generically dependent continuant that is about some thing."@en ;
                rdfs:label "information content entity"@en .


###  http://purl.obolibrary.org/obo/IAO_0000033
obo:IAO_0000033 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000030 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:IAO_0000136 ;
                                  owl:someValuesFrom obo:BFO_0000017
                                ] ;
                obo:IAO_0000115 "An information content entity whose concretizations indicate to their bearer how to realize them in a process."@en ;
                rdfs:label "directive information entity"@en .


###  http://purl.obolibrary.org/obo/IAO_0000078
obo:IAO_0000078 rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:oneOf ( obo:IAO_0000002
                                                  obo:IAO_0000120
                                                  obo:IAO_0000121
                                                  obo:IAO_0000122
                                                  obo:IAO_0000123
                                                  obo:IAO_0000124
                                                  obo:IAO_0000125
                                                  obo:IAO_0000423
                                                  obo:IAO_0000428
                                                )
                                    ] ;
                rdfs:subClassOf obo:IAO_0000102 ;
                obo:IAO_0000115 "The curation status of the term. The allowed values come from an enumerated list of predefined terms. See the specification of these instances for more detailed definitions of each enumerated value."@en ;
                rdfs:label "curation status specification"@en .


###  http://purl.obolibrary.org/obo/IAO_0000100
obo:IAO_0000100 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0001000 ;
                obo:IAO_0000115 "A data item that is an aggregate of other data items of the same type that have something in common. Averages and distributions can be determined for data sets."@en ;
                rdfs:label "homogenous data collection"@en .


###  http://purl.obolibrary.org/obo/IAO_0000102
obo:IAO_0000102 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000027 ;
                obo:IAO_0000115 "Data about an ontology part is a data item about a part of an ontology, for example a term"@en ;
                rdfs:label "data about an ontology part"@en .


###  http://purl.obolibrary.org/obo/IAO_0000225
obo:IAO_0000225 rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:oneOf ( obo:IAO_0000103
                                                  obo:IAO_0000226
                                                  obo:IAO_0000227
                                                  obo:IAO_0000228
                                                  obo:IAO_0000229
                                                  obo:OMO_0001000
                                                )
                                    ] ;
                rdfs:subClassOf obo:IAO_0000102 ;
                obo:IAO_0000115 "The reason for which a term has been deprecated. The allowed values come from an enumerated list of predefined terms. See the specification of these instances for more detailed definitions of each enumerated value."@en ;
                rdfs:label "obsolescence reason specification"@en .


###  http://purl.obolibrary.org/obo/IAO_0000409
obo:IAO_0000409 rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:oneOf ( obo:IAO_0000410
                                                  obo:IAO_0000420
                                                  obo:IAO_0000421
                                                )
                                    ] ;
                rdfs:subClassOf obo:IAO_0000102 ;
                obo:IAO_0000115 "A denotator type indicates how a term should be interpreted from an ontological perspective."@en ;
                rdfs:label "denotator type"@en .


###  http://purl.obolibrary.org/obo/IAO_0000577
obo:IAO_0000577 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000028 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000050 ;
                                  owl:someValuesFrom obo:IAO_0000578
                                ] ;
                obo:IAO_0000115 "A symbol that is part of a CRID and that is sufficient to look up a record from the CRID's registry."@en ;
                rdfs:label "centrally registered identifier symbol"@en .


###  http://purl.obolibrary.org/obo/IAO_0000578
obo:IAO_0000578 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0020000 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000051 ;
                                  owl:someValuesFrom obo:IAO_0000577
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000051 ;
                                  owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                       owl:onProperty obo:IAO_0000219 ;
                                                       owl:someValuesFrom obo:IAO_0000579
                                                     ]
                                ] ;
                obo:IAO_0000115 "An information content entity that consists of a CRID symbol and additional information about the CRID registry to which it belongs."@en ;
                rdfs:label "centrally registered identifier"@en .


###  http://purl.obolibrary.org/obo/IAO_0000579
obo:IAO_0000579 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0020020 ;
                obo:IAO_0000115 "A code set of CRID records, each consisting of a CRID symbol and additional information which was recorded in the code set through an assigning a centrally registered identifier process."@en ;
                rdfs:label "centrally registered identifier registry"@en .


###  http://purl.obolibrary.org/obo/IAO_0001000
obo:IAO_0001000 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000027 ;
                obo:IAO_0000115 "A data entity that consists of multiple data entities."@en ;
                rdfs:label "data collection"@en .


###  http://purl.obolibrary.org/obo/IAO_0020000
obo:IAO_0020000 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( obo:IAO_0000030
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty obo:IAO_0000219 ;
                                                             owl:someValuesFrom obo:BFO_0000001
                                                           ]
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty obo:OBI_0000312 ;
                                                             owl:someValuesFrom obo:IAO_0020010
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf obo:IAO_0000030 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:IAO_0000219 ;
                                  owl:someValuesFrom obo:BFO_0000001
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:OBI_0000312 ;
                                  owl:someValuesFrom obo:IAO_0020010
                                ] ;
                obo:IAO_0000115 "An information content entity that is the outcome of a dubbing process and is used to refer to one instance of entity shared by a group of people to refer to that individual entity."@en ;
                rdfs:label "identifier"@en .


###  http://purl.obolibrary.org/obo/IAO_0020010
obo:IAO_0020010 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( obo:COB_0000035
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty obo:OBI_0000299 ;
                                                             owl:someValuesFrom obo:IAO_0020000
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf obo:COB_0000035 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:OBI_0000299 ;
                                  owl:someValuesFrom obo:IAO_0020000
                                ] ;
                obo:IAO_0000115 "A planned process that provides a reference to an individual entity shared by a group of subscribers to refer to that individual entity."@en ;
                rdfs:label "identifier creating process"@en .


###  http://purl.obolibrary.org/obo/IAO_0020020
obo:IAO_0020020 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000030 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000051 ;
                                  owl:someValuesFrom obo:IAO_0020000
                                ] ;
                obo:IAO_0000115 "An information content entity that is a collection of other information content entities that has been created to identify or annotate things in a specified domain, and where the intention of its creators is that the collection has a one-to-one correspondence with those things."@en ;
                rdfs:label "code set"@en .


###  https://spec.industrialontologies.org/ontology/construct/MaterialArtifact
iof-constr:MaterialArtifact rdf:type owl:Class ;
                            owl:disjointWith ofl:OFL_0000004 .


###  https://spec.industrialontologies.org/ontology/core/Core/Capability
<https://spec.industrialontologies.org/ontology/core/Core/Capability> rdf:type owl:Class ;
                                                                      rdfs:subClassOf obo:BFO_0000016 ;
                                                                      rdfs:label "capability"@en-us ;
                                                                      skos:example "Capability of a person to play chess at the \"master\" level; of a team to play football in the professional league; of a lathe to turn at maximal speed of 4,000 RPM; or of your digestive system to digest tiramisu."@en-us .


###  https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/MaturityLevel
<https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/MaturityLevel> rdf:type owl:Class ;
                                                                                              rdfs:label "maturity level"@en-us .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000001
ofl:OFL_0000001 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000578 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ofl:OFL_0000016 ;
                                  owl:someValuesFrom ofl:OFL_0000004
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ofl:OFL_0000016 ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass ofl:OFL_0000004
                                ] ;
                owl:disjointWith ofl:OFL_0000005 ;
                rdfs:label "Equipment Tag"@en ,
                           "Tag de Equipamento"@pt-br ;
                skos:altLabel "Tag"@en ,
                              "Tag"@pt-br ;
                skos:example "PT-23424 (posição de transmissor de pressão)"@pt-br ,
                             "PT-23424 (pressure transmitter position)"@en ,
                             "XV-23423 (control valve position)"@en ;
                skos:prefLabel "Equipment Tag"@en ,
                               "Tag de Equipamento"@pt-br ;
                iof-av:explanatoryNote "Convenções de prefixo da tag: XV = válvula de controle, PSV = válvula de segurança de pressão, PT = transmissor de pressão, FT = transmissor de vazão, LV = válvula de nível. Estes são resumos convencionalizados da classificação funcional da especificação, mas não substituem a especificação."@pt-br ,
                                       "Tag prefix conventions: XV = control valve, PSV = pressure safety valve, PT = pressure transmitter, FT = flow transmitter, LV = level valve. These are conventionalized summaries of the specification's functional classification but do not replace the specification."@en ;
                iof-av:firstOrderLogicDefinition "EquipmentTag(x) → Identifier(x) ∧ ∃!y(FunctionalLocation(y) ∧ identifiesLocation(x,y)) ∧ ¬FunctionalLocationCode(x)"@en ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "An equipment tag is an identifier that denotes a functional location through industrial naming conventions, where the tag prefix encodes the expected equipment type at the position. The tag does not denote the physical equipment — the relationship between tag and equipment is mediated through the functional location."@en ,
                                                 "Uma tag de equipamento é um identificador que denota um local de instalação através de convenções industriais de nomenclatura, onde o prefixo da tag codifica o tipo esperado de equipamento na posição. A tag não denota o equipamento físico — a relação entre tag e equipamento é mediada pelo local de instalação."@pt-br ;
                iof-av:semiFormalNaturalLanguageDefinition "every instance of EquipmentTag is an instance of iao:CentrallyRegisteredIdentifier that identifiesLocation exactly one FunctionalLocation and that is disjoint from FunctionalLocationCode"@en ;
                iof-av:usageNote "Quando engenheiros dizem 'válvula XV-23424', eles usam a tag de equipamento como uma abreviação pragmática para 'o equipamento atualmente instalado na posição denotada por XV-23424'."@pt-br ,
                                 "When engineers say 'valve XV-23424', they use the equipment tag as a pragmatic shorthand for 'the equipment currently installed at the position denoted by XV-23424'."@en .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000002
ofl:OFL_0000002 rdf:type owl:Class ;
                rdfs:subClassOf ofl:OFL_0000004 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ofl:OFL_0000024 ;
                                  owl:someValuesFrom ofl:OFL_0000034
                                ] ;
                rdfs:label "Equipment Unit Site"@en ,
                           "Sítio da Unidade de Equipamento"@pt-br ;
                iof-av:adaptedFrom "ISO 14224:2016 Level 4: Equipment Unit"@en ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "An equipment unit site is a functional location that represents a unit within a subsystem in the ISO 14224 hierarchy."@en ,
                                                 "Um sítio da unidade de equipamento é um local de instalação que representa uma unidade dentro de um subsistema na hierarquia ISO 14224."@pt-br .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003
ofl:OFL_0000003 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000034 ;
                rdfs:label "Flow Regulation Function"@en ,
                           "Função de Regulação de Fluxo"@pt-br ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A flow regulation function is a BFO function that is realized in a process of controlling the rate, direction, or pressure of fluid flow through a piping system by varying the resistance to flow."@en ,
                                                 "Uma função de regulação de fluxo é uma função BFO que é realizada em um processo de controlar a vazão, direção ou pressão do fluxo de fluido através de um sistema de tubulação variando a resistência ao fluxo."@pt-br .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000004
ofl:OFL_0000004 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000029 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ofl:OFL_0000007 ;
                                  owl:someValuesFrom obo:BFO_0000040
                                ] ;
                rdfs:label "Functional Location"@en ,
                           "Local de Instalação"@pt-br ;
                rdfs:seeAlso "CQ1: Current equipment assignment"@en ,
                             "CQ3: Hierarchical navigation"@en ,
                             "CQ5: Spatial proximity"@en ;
                skos:altLabel "FL"@en ,
                              "LI"@pt-br ;
                skos:example "Site for pressure transmitter PT-23424 in gas dehydration system"@en ,
                             "Sítio para o transmissor de pressão PT-23424 no sistema de desidratação de gás"@pt-br ;
                skos:prefLabel "Functional Location"@en ,
                               "Local de Instalação"@pt-br ;
                iof-av:adaptedFrom "ISO 14224:2016 — 'a position in a functional hierarchy where a maintainable item is or can be installed'"@en ;
                iof-av:explanatoryNote "A escolha de bfo:Site como categoria de fundamentação resulta de uma eliminação sistemática de alternativas: MaterialEntity falha na persistência quando vazio, Role falha na persistência (requer portador), InformationContentEntity falha nas consultas espaciais, SpatialRegion falha na relatividade à estrutura da planta. Somente Site satisfaz todos os requisitos simultaneamente."@pt-br ,
                                       "The choice of bfo:Site as the grounding category results from a systematic elimination of alternatives: MaterialEntity fails persistence when empty, Role fails persistence (requires bearer), InformationContentEntity fails spatial queries, SpatialRegion fails relativity to plant structure. Only Site satisfies all requirements simultaneously."@en ;
                iof-av:firstOrderLogicDefinition "FunctionalLocation(x) → Site(x) ∧ ∃y(MaterialEntity(y) ∧ hasBoundaryDeterminedBy(x,y)) ∧ ¬MaterialArtifact(x)"@en ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A functional location is a site that is a persistent spatial position in an industrial facility hierarchy where a maintainable item is or can be installed, and whose boundaries are determined in relation to delimiting material structures rather than by the equipment that may occupy it."@en ,
                                                 "Um local de instalação é um sítio que é uma posição espacial persistente em uma hierarquia de instalação industrial onde um item manutenível está ou pode ser instalado, e cujos limites são determinados em relação a estruturas materiais delimitadoras e não pelo equipamento que possa ocupá-lo."@pt-br ;
                iof-av:semiFormalNaturalLanguageDefinition "every instance of FunctionalLocation is an instance of bfo:Site that (1) has its boundaries determined by some MaterialEntity, (2) persists independently of whether any Equipment is installed at it, and (3) participates in an ISO 14224 hierarchical decomposition via partOfSystemSite"@en ;
                iof-av:synonym "Installation Position"@en ,
                               "Posição de Instalação"@pt-br ,
                               "Tag Location"@en ;
                iof-av:usageNote "A functional location persists when empty — when equipment is removed, the inlet/outlet nozzles and foundation bolts remain, so the site boundaries remain anchored."@en ,
                                 "Um local de instalação persiste quando vazio — quando o equipamento é removido, os bocais de entrada/saída e os parafusos de fundação permanecem, então os limites do sítio permanecem ancorados."@pt-br .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000005
ofl:OFL_0000005 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000578 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ofl:OFL_0000015 ;
                                  owl:someValuesFrom ofl:OFL_0000004
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ofl:OFL_0000015 ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass ofl:OFL_0000004
                                ] ;
                rdfs:label "Código do Local de Instalação"@pt-br ,
                           "Functional Location Code"@en ;
                skos:altLabel "Código LI"@pt-br ,
                              "FL Code"@en ;
                skos:example "30142.FSGE.FEW.10.01.1"@en ,
                             "30234.FSFS.FWSF.10.01.01"@en ;
                skos:prefLabel "Código do Local de Instalação"@pt-br ,
                               "Functional Location Code"@en ;
                iof-av:adaptedFrom "ISO 14224:2016 — five-level hierarchical coding scheme"@en ;
                iof-av:explanatoryNote "Distinct from EquipmentTag: the FL code encodes organizational hierarchy (WHERE in the structure), while the equipment tag encodes functional designation (WHAT type of equipment is expected). Both denote the same functional location."@en ,
                                       "Distinto da Tag de Equipamento: o código LI codifica a hierarquia organizacional (ONDE na estrutura), enquanto a tag de equipamento codifica a designação funcional (QUE tipo de equipamento é esperado). Ambos denotam o mesmo local de instalação."@pt-br ;
                iof-av:firstOrderLogicDefinition "FunctionalLocationCode(x) → Identifier(x) ∧ ∃!y(FunctionalLocation(y) ∧ identifies(x,y)) ∧ ¬EquipmentTag(x)"@en ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A functional location code is an identifier that denotes a functional location by encoding the position's place in the ISO 14224 organizational hierarchy, with segments representing plant, system, subsystem, equipment unit, and maintainable item levels."@en ,
                                                 "Um código de local de instalação é um identificador que denota um local de instalação codificando a posição do local na hierarquia organizacional ISO 14224, com segmentos representando os níveis de planta, sistema, subsistema, unidade de equipamento e item manutenível."@pt-br ;
                iof-av:semiFormalNaturalLanguageDefinition "every instance of FunctionalLocationCode is an instance of iao:CentrallyRegisteredIdentifier that identifies exactly one FunctionalLocation and that is disjoint from EquipmentTag"@en .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000006
ofl:OFL_0000006 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000033 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ofl:OFL_0000032 ;
                                  owl:someValuesFrom ofl:OFL_0000004
                                ] ;
                rdfs:label "Especificação do Local de Instalação"@pt-br ,
                           "Functional Location Specification"@en ;
                skos:example "Especificação requerendo função de medição de pressão, faixa 0-350 bar, ATEX Zona 1"@pt-br ,
                             "Spec requiring pressure sensing function, range 0-350 bar, ATEX Zone 1"@en ;
                skos:prefLabel "Especificação do Local de Instalação"@pt-br ,
                               "Functional Location Specification"@en ;
                iof-av:explanatoryNote "Relacionada mas distinta da Tag de Equipamento: duas posições podem compartilhar o mesmo prefixo de tag (ex., ambas XV-) enquanto possuem especificações diferentes (uma classificada para 150 bar, outra para 300 bar). Corresponde a IDO lis:Specified no mapeamento IDO."@pt-br ,
                                       "Related to but distinct from EquipmentTag: two positions may share the same tag prefix (e.g., both XV-) while having different specifications (one rated for 150 bar, another for 300 bar). Corresponds to IDO lis:Specified in the IDO mapping."@en ;
                iof-av:firstOrderLogicDefinition "FunctionalLocationSpecification(x) → DirectiveInformationEntity(x) ∧ ∃y(FunctionalLocation(y) ∧ specifiesLocation(x,y)) ∧ ∃z(Function(z) ∧ requiresFunction(x,z))"@en ;
                iof-av:isPrimitive "false"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A functional location specification is a directive information entity that prescribes the required function and technical constraints (such as pressure ratings, material requirements, and interface dimensions) at a functional location. Specifications persist independently of installed equipment and may evolve over the plant lifecycle."@en ,
                                                 "Uma especificação de local de instalação é uma entidade informacional diretiva que prescreve a função requerida e as restrições técnicas (tais como classificações de pressão, requisitos de material e dimensões de interface) em um local de instalação. Especificações persistem independentemente do equipamento instalado e podem evoluir ao longo do ciclo de vida da planta."@pt-br ;
                iof-av:semiFormalNaturalLanguageDefinition "every instance of FunctionalLocationSpecification is an instance of iao:DirectiveInformationEntity that specifiesLocation some FunctionalLocation and requiresFunction some bfo:Function"@en ;
                iof-av:synonym "Especificação LI"@pt-br ,
                               "FL Specification"@en .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000020
ofl:OFL_0000020 rdf:type owl:Class ;
                rdfs:subClassOf ofl:OFL_0000004 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ofl:OFL_0000024 ;
                                  owl:someValuesFrom ofl:OFL_0000002
                                ] ;
                rdfs:label "Maintainable Item Site"@en ,
                           "Sítio do Item Manutenível"@pt-br ;
                skos:example "Site for individual sensor PT-23424"@en ,
                             "Sítio para o sensor individual PT-23424"@pt-br ;
                iof-av:adaptedFrom "ISO 14224:2016 Level 5: Maintainable Item"@en ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A maintainable item site is a functional location that is the lowest level in the ISO 14224 hierarchy where a single maintainable item is or can be installed."@en ,
                                                 "Um sítio do item manutenível é um local de instalação que é o nível mais baixo na hierarquia ISO 14224 onde um único item manutenível está ou pode ser instalado."@pt-br .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000021
ofl:OFL_0000021 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000100 ;
                rdfs:label "Maintenance Note"@en ,
                           "Nota de Manutenção"@pt-br ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A maintenance note is a data item that is a textual record created during maintenance work, anchored to a functional location rather than to equipment for persistence across replacements."@en ,
                                                 "Uma nota de manutenção é um item de dado que é um registro textual criado durante trabalho de manutenção, ancorado a um local de instalação ao invés de ao equipamento para persistência através de substituições."@pt-br .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000026
ofl:OFL_0000026 rdf:type owl:Class ;
                rdfs:subClassOf ofl:OFL_0000004 ;
                rdfs:label "Plant Site"@en ,
                           "Sítio da Planta"@pt-br ;
                skos:example "Offshore platform P-74"@en ,
                             "Plataforma offshore P-74"@pt-br ;
                iof-av:adaptedFrom "ISO 14224:2016 Level 1: Plant"@en ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A plant site is a functional location that is the highest level in the ISO 14224 hierarchy, representing an entire industrial plant or facility."@en ,
                                                 "Um sítio da planta é um local de instalação que é o nível mais alto na hierarquia ISO 14224, representando uma planta ou instalação industrial inteira."@pt-br .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000028
ofl:OFL_0000028 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000023 ;
                rdfs:label "Papel Requerido"@pt-br ,
                           "Required Role"@en ;
                skos:example "Papel de estrangulamento variável, papel de controle de alta pressão"@pt-br ,
                             "Variable choking role, high-pressure control role"@en ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A required role is a BFO role that specifies the functional requirements for equipment at a functional location."@en ,
                                                 "Um papel requerido é um papel BFO que especifica os requisitos funcionais para equipamento em um local de instalação."@pt-br .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000031
ofl:OFL_0000031 rdf:type owl:Class ;
                rdfs:subClassOf iof-constr:MaterialArtifact ;
                rdfs:label "Sensor"@en ,
                           "Sensor"@pt-br ;
                skos:example "Pressure sensor installed at position PT-23424"@en ,
                             "Sensor de pressão instalado na posição PT-23424"@pt-br ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A sensor is an equipment item that measures physical properties such as pressure, temperature, or flow."@en ,
                                                 "Um sensor é um item de equipamento que mede propriedades físicas tais como pressão, temperatura ou vazão."@pt-br .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000034
ofl:OFL_0000034 rdf:type owl:Class ;
                rdfs:subClassOf ofl:OFL_0000004 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ofl:OFL_0000024 ;
                                  owl:someValuesFrom ofl:OFL_0000035
                                ] ;
                rdfs:label "Subsystem Site"@en ,
                           "Sítio do Subsistema"@pt-br ;
                skos:example "Inlet Separator subsystem site within Gas Dehydration System"@en ;
                iof-av:adaptedFrom "ISO 14224:2016 Level 3: Subsystem"@en ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A subsystem site is a functional location that represents a subsystem within a system in the ISO 14224 hierarchy."@en ,
                                                 "Um sítio do subsistema é um local de instalação que representa um subsistema dentro de um sistema na hierarquia ISO 14224."@pt-br .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000035
ofl:OFL_0000035 rdf:type owl:Class ;
                rdfs:subClassOf ofl:OFL_0000004 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ofl:OFL_0000024 ;
                                  owl:someValuesFrom ofl:OFL_0000026
                                ] ;
                rdfs:label "System Site"@en ,
                           "Sítio do Sistema"@pt-br ;
                skos:example "Gas Dehydration System site within platform P-74"@en ,
                             "Sítio do Sistema de Desidratação de Gás dentro da plataforma P-74"@pt-br ;
                iof-av:adaptedFrom "ISO 14224:2016 Level 2: System"@en ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A system site is a functional location that represents a major system within a plant in the ISO 14224 hierarchy."@en ,
                                                 "Um sítio do sistema é um local de instalação que representa um sistema principal dentro de uma planta na hierarquia ISO 14224."@pt-br .


###  https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000036
ofl:OFL_0000036 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000100 ;
                rdfs:label "Conjunto de Dados Medidos com Carimbo de Tempo"@pt-br ,
                           "Time-Stamped Measured Dataset"@en ;
                rdfs:seeAlso "CQ2: Temporal continuity across equipment replacements"@en ;
                iof-av:isPrimitive "true"^^xsd:boolean ;
                iof-av:maturity iof-ind:Provisional ;
                iof-av:naturalLanguageDefinition "A time-stamped measured dataset is a data item that contains time-series observations indexed by a functional location for persistent data anchoring across equipment replacements."@en ,
                                                 "Um conjunto de dados medidos com carimbo de tempo é um item de dado que contém observações de séries temporais indexadas por um local de instalação para ancoragem persistente de dados através de substituições de equipamento."@pt-br .


