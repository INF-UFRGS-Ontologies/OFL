        <annotation:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <annotation:naturalLanguageDefinition xml:lang="en">A relation between a functional location and a required role such that equipment installed at the functional location must bear the specified role.</annotation:naturalLanguageDefinition>
        <annotation:naturalLanguageDefinition xml:lang="pt-br">Uma relação entre um local de instalação e um papel requerido tal que o equipamento instalado no local de instalação deve portar o papel especificado.</annotation:naturalLanguageDefinition>
