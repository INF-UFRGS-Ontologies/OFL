        <annotation:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <annotation:naturalLanguageDefinition xml:lang="en">A relation between a functional location specification and a functional location such that the specification prescribes the required function and technical constraints at the functional location.</annotation:naturalLanguageDefinition>
        <annotation:naturalLanguageDefinition xml:lang="pt-br">Uma relação entre uma especificação de local de instalação e um local de instalação tal que a especificação prescreve a função requerida e as restrições técnicas no local de instalação.</annotation:naturalLanguageDefinition>
