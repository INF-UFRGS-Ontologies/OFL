        <annotation:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</annotation:isPrimitive>
        <annotation:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <annotation:naturalLanguageDefinition xml:lang="en">A relation between a functional location specification and a BFO function such that the specification prescribes that the function must be realized by equipment installed at the associated functional location.</annotation:naturalLanguageDefinition>
        <annotation:naturalLanguageDefinition xml:lang="pt-br">Uma relação entre uma especificação de local de instalação e uma função BFO tal que a especificação prescreve que a função deve ser realizada pelo equipamento instalado no local de instalação associado.</annotation:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000030 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000030">
        <rdfs:label xml:lang="pt-br">requer papel</rdfs:label>
        <rdfs:label xml:lang="en">requires role</rdfs:label>
