<?xml version="1.0"?>
<rdf:RDF xmlns="https://www.inf.ufrgs.br/ontologies/ofl/ofl-simple.owl#"
     xml:base="https://www.inf.ufrgs.br/ontologies/ofl/ofl-simple.owl"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:annotation="https://spec.industrialontologies.org/ontology/annotation/">
    <owl:Ontology rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/ofl-simple.owl">
        <owl:versionIRI rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/releases/2026-11-09/ofl-simple.owl"/>
        <terms:contributor xml:lang="en">Cauã Antunes</terms:contributor>
        <terms:contributor xml:lang="en">Haroldo Rojas</terms:contributor>
        <terms:contributor xml:lang="en">Joel Carbonera</terms:contributor>
        <terms:contributor xml:lang="en">Mara Abel</terms:contributor>
        <terms:contributor xml:lang="en">Rafael Petry</terms:contributor>
        <terms:contributor xml:lang="en">Regis Romeu</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-17</terms:created>
        <terms:creator xml:lang="en">Nicolau Santos</terms:creator>
        <terms:description xml:lang="en">A BFO-compliant ontology for modeling functional locations as persistent spatial sites in industrial asset management systems, based on the Ontology Design Pattern developed by Santos et al. (2026). The pattern separates five concerns: spatial site (bfo:Site), organizational code (iao:CentrallyRegisteredIdentifier), equipment tag (iao:CentrallyRegisteredIdentifier), functional specification (iao:DirectiveInformationEntity), and installed equipment (iof:MaterialArtifact). Both identifiers denote the functional location site, not the physical equipment — the relationship to equipment is always mediated through the site.</terms:description>
        <terms:description xml:lang="pt-br">Uma ontologia em conformidade com a BFO para modelar locais de instalação como sítios espaciais persistentes em sistemas de gestão de ativos industriais, baseada no padrão de projeto ontológico desenvolvido por Santos et al. (2026). O padrão separa cinco preocupações: sítio espacial (bfo:Site), código do local de instalação (iao:CentrallyRegisteredIdentifier), tag de equipamento (iao:CentrallyRegisteredIdentifier), especificação funcional (iao:DirectiveInformationEntity) e equipamento instalado (iof:MaterialArtifact). Ambos os identificadores denotam o local de instalação, não o equipamento físico — a relação com o equipamento é sempre mediada pelo sítio.</terms:description>
        <terms:license rdf:resource="http://opensource.org/licenses/MIT"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-01</terms:modified>
        <terms:subject xml:lang="en">Functional Location</terms:subject>
        <terms:subject xml:lang="pt-br">Gestão de Ativos Industriais</terms:subject>
        <terms:subject xml:lang="en">ISO 14224</terms:subject>
        <terms:subject xml:lang="en">Industrial Asset Management</terms:subject>
        <terms:subject xml:lang="pt-br">Local de Instalação</terms:subject>
        <terms:title xml:lang="pt-br">Ontologia de Locais de Instalação</terms:title>
        <terms:title xml:lang="en">Ontology of Functional Locations</terms:title>
        <owl:versionInfo>2026-11-09</owl:versionInfo>
    </owl:Ontology>
    


