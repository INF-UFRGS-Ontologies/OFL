    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000006 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000006">
        <rdfs:domain rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:label xml:lang="en">has boundary determined by</rdfs:label>
        <rdfs:label xml:lang="pt-br">tem limite determinado por</rdfs:label>
        <skos:example xml:lang="en">FL_PT23424_Site hasBoundaryDeterminedBy DeckC_Structure</skos:example>
        <iof-av:firstOrderLogicDefinition xml:lang="en">hasBoundaryDeterminedBy(x,y) → FunctionalLocation(x) ∧ MaterialEntity(y) ∧ boundaryOf(x) determinedInRelationTo(y)</iof-av:firstOrderLogicDefinition>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A relation between a functional location and a material entity such that the material entity provides the reference frame that determines the spatial boundaries of the functional location.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma relação entre um local de instalação e uma entidade material tal que a entidade material fornece o referencial que determina os limites espaciais do local de instalação.</iof-av:naturalLanguageDefinition>
        <iof-av:semiFormalNaturalLanguageDefinition xml:lang="en">if x hasBoundaryDeterminedBy y then x is a FunctionalLocation and y is a MaterialEntity and the spatial boundaries of x are determined in relation to y</iof-av:semiFormalNaturalLanguageDefinition>
        <iof-av:usageNote xml:lang="en">Implements BFO site semantics: site boundaries are determined in relation to material entities but not by coincidence with those entities.</iof-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000011 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000011">
        <owl:inverseOf rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000023"/>
        <rdfs:label xml:lang="en">has system site part</rdfs:label>
        <rdfs:label xml:lang="pt-br">tem parte de sítio do sistema</rdfs:label>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000012 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000012">
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
        <rdfs:range rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000001"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000017"/>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000015"/>
            </rdf:Description>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="en">has tag</rdfs:label>
        <rdfs:label xml:lang="pt-br">tem tag</rdfs:label>
        <iof-av:explanatoryNote xml:lang="pt-br">Esta relação captura a abreviação pragmática industrial onde engenheiros dizem &apos;válvula XV-23424&apos; para significar &apos;a válvula atualmente instalada na posição denotada por XV-23424&apos;. A tag não denota o equipamento — denota a posição.</iof-av:explanatoryNote>
        <iof-av:explanatoryNote xml:lang="en">This relation captures the industrial pragmatic shorthand where engineers say &apos;valve XV-23424&apos; to mean &apos;the valve currently installed at the position denoted by XV-23424&apos;. The tag does not denote the equipment — it denotes the position.</iof-av:explanatoryNote>
        <iof-av:firstOrderLogicDefinition xml:lang="en">hasTag(x,y) ↔ ∃z(FunctionalLocation(z) ∧ installedAt(x,z) ∧ identifiesLocation(y,z))</iof-av:firstOrderLogicDefinition>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A derived relation between equipment and an equipment tag such that the equipment is installed at the functional location identified by the tag. This relation is not asserted but entailed through a property chain: equipment is installedAt a FunctionalLocation, and the EquipmentTag identifiesLocation that same FunctionalLocation.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma relação derivada entre um equipamento e uma tag de equipamento tal que o equipamento está instalado no local de instalação identificado pela tag. Esta relação não é assertada, mas inferida por uma cadeia de propriedades: o equipamento está installedAt um FunctionalLocation, e a EquipmentTag identifiesLocation o mesmo FunctionalLocation.</iof-av:naturalLanguageDefinition>
        <iof-av:semiFormalNaturalLanguageDefinition xml:lang="en">if x hasTag y then there exists a FunctionalLocation z such that x installedAt z and y identifiesLocation z</iof-av:semiFormalNaturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000013 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000013">
        <rdfs:domain rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000030"/>
        <rdfs:range rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
        <rdfs:label xml:lang="pt-br">hospedado por</rdfs:label>
        <rdfs:label xml:lang="en">hosted by</rdfs:label>
        <skos:example xml:lang="en">Sensor PT-23424 hostedBy Valve XV-22342</skos:example>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A relation between a sensor and an equipment item such that the sensor is physically mounted on the equipment item. The sensor has its own functional location but is physically hosted by the equipment.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma relação entre um sensor e um item de equipamento tal que o sensor está fisicamente montado no item de equipamento. O sensor tem seu próprio local de instalação, mas é fisicamente hospedado pelo equipamento.</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000014 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000014">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000219"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000004"/>
        <rdfs:range rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
        <rdfs:label xml:lang="pt-br">identifica</rdfs:label>
        <rdfs:label xml:lang="en">identifies</rdfs:label>
        <iof-av:firstOrderLogicDefinition xml:lang="en">identifies(x,y) → FunctionalLocationCode(x) ∧ FunctionalLocation(y) ∧ denotes(x,y) ∧ ∀z(identifies(x,z) → z = y)</iof-av:firstOrderLogicDefinition>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A relation between a functional location code and a functional location such that the code uniquely denotes the functional location within the organizational hierarchy following the ISO 14224 coding scheme.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma relação entre um código de local de instalação e um local de instalação tal que o código denota unicamente o local de instalação dentro da hierarquia organizacional seguindo o esquema de codificação ISO 14224.</iof-av:naturalLanguageDefinition>
        <iof-av:semiFormalNaturalLanguageDefinition xml:lang="en">if x identifies y then x is a FunctionalLocationCode and y is a FunctionalLocation and x uniquely denotes y</iof-av:semiFormalNaturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000015 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000015">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000219"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000001"/>
        <rdfs:range rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
        <rdfs:label xml:lang="pt-br">identifica local de instalação</rdfs:label>
        <rdfs:label xml:lang="en">identifies location</rdfs:label>
        <iof-av:explanatoryNote xml:lang="en">CRITICAL DESIGN DECISION: The equipment tag denotes the functional location (the position), NOT the physical equipment. The relationship between tag and equipment is mediated through the site via the hasTag property chain.</iof-av:explanatoryNote>
        <iof-av:explanatoryNote xml:lang="pt-br">DECISÃO DE PROJETO CRÍTICA: A tag de equipamento denota o local de instalação (a posição), NÃO o equipamento físico. A relação entre tag e equipamento é mediada pelo sítio através da cadeia de propriedades hasTag.</iof-av:explanatoryNote>
        <iof-av:firstOrderLogicDefinition xml:lang="en">identifiesLocation(x,y) → EquipmentTag(x) ∧ FunctionalLocation(y) ∧ denotes(x,y) ∧ ∀z(identifiesLocation(x,z) → z = y)</iof-av:firstOrderLogicDefinition>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A relation between an equipment tag and a functional location such that the tag uniquely identifies the functional location where equipment of the designated type is or can be installed. The tag prefix convention encodes the expected equipment type at the position.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma relação entre uma tag de equipamento e um local de instalação tal que a tag identifica unicamente o local de instalação onde equipamento do tipo designado está ou pode ser instalado. A convenção de prefixo da tag codifica o tipo esperado de equipamento na posição.</iof-av:naturalLanguageDefinition>
        <iof-av:semiFormalNaturalLanguageDefinition xml:lang="en">if x identifiesLocation y then x is an EquipmentTag and y is a FunctionalLocation and x denotes y</iof-av:semiFormalNaturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000016 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000016">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000035"/>
        <rdfs:range rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
        <rdfs:label xml:lang="pt-br">indexado por sítio</rdfs:label>
        <rdfs:label xml:lang="en">indexed by site</rdfs:label>
        <rdfs:seeAlso xml:lang="en">CQ2: Temporal continuity across replacements</rdfs:seeAlso>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A relation between a time-stamped measured dataset and a functional location such that the dataset is indexed by the functional location rather than by individual equipment instances, enabling automatic data continuity across equipment replacements.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma relação entre um conjunto de dados medidos com carimbo de tempo e um local de instalação tal que o conjunto de dados é indexado pelo local de instalação ao invés de por instâncias individuais de equipamento, permitindo continuidade automática de dados através de substituições de equipamento.</iof-av:naturalLanguageDefinition>
        <iof-av:usageNote xml:lang="en">KEY PATTERN: Enables automatic continuity without application logic to &apos;stitch&apos; data from different equipment instances.</iof-av:usageNote>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000017 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000017">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000171"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
        <rdfs:range rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
        <rdfs:label xml:lang="pt-br">instalado em</rdfs:label>
        <rdfs:label xml:lang="en">installed at</rdfs:label>
        <skos:example xml:lang="en">Sensor_PT23424_v2 installedAt FL_PT23424_Site (2017-06-16 to 2022-03-10)</skos:example>
        <iof-av:firstOrderLogicDefinition xml:lang="en">installedAt(x,y) → MaterialArtifact(x) ∧ FunctionalLocation(y) ∧ ∃t(located_in(x,y,t))</iof-av:firstOrderLogicDefinition>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A relation between a piece of equipment and a functional location such that the equipment is physically installed at the functional location during some temporally bounded period. The temporal bounds are captured via installedDate and removedDate data properties.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma relação entre uma peça de equipamento e um local de instalação tal que o equipamento está fisicamente instalado no local de instalação durante algum período temporalmente delimitado. Os limites temporais são capturados pelas propriedades de dados installedDate e removedDate.</iof-av:naturalLanguageDefinition>
        <iof-av:semiFormalNaturalLanguageDefinition xml:lang="en">if x installedAt y then x is a MaterialArtifact and y is a FunctionalLocation and x is located in y at some time</iof-av:semiFormalNaturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000023 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000023">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
        <rdfs:range rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
        <rdfs:label xml:lang="en">part of system site</rdfs:label>
        <rdfs:label xml:lang="pt-br">parte de sítio do sistema</rdfs:label>
        <skos:example xml:lang="en">MaintainableItemSite partOfSystemSite EquipmentUnitSite</skos:example>
        <skos:example xml:lang="en">SubsystemSite partOfSystemSite SystemSite</skos:example>
        <iof-av:firstOrderLogicDefinition xml:lang="en">partOfSystemSite(x,y) → FunctionalLocation(x) ∧ FunctionalLocation(y) ∧ partOf(x,y)</iof-av:firstOrderLogicDefinition>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A relation between two functional locations such that the first is a proper part of the second in the ISO 14224 hierarchical decomposition. This relation is transitive, enabling queries across hierarchy levels.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma relação entre dois locais de instalação tal que o primeiro é parte própria do segundo na decomposição hierárquica ISO 14224. Esta relação é transitiva, permitindo consultas através dos níveis hierárquicos.</iof-av:naturalLanguageDefinition>
        <iof-av:semiFormalNaturalLanguageDefinition xml:lang="en">if x partOfSystemSite y then x is a FunctionalLocation and y is a FunctionalLocation and x is part of y</iof-av:semiFormalNaturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000024 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000024">
        <rdfs:domain rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000020"/>
        <rdfs:range rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
        <rdfs:label xml:lang="en">performed at</rdfs:label>
        <rdfs:label xml:lang="pt-br">realizada em</rdfs:label>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A relation between a maintenance note and a functional location such that the maintenance note documents work performed at the functional location.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma relação entre uma nota de manutenção e um local de instalação tal que a nota de manutenção documenta trabalho realizado no local de instalação.</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000028 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000028">
        <rdfs:domain rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000005"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <rdfs:label xml:lang="pt-br">requer função</rdfs:label>
        <rdfs:label xml:lang="en">requires function</rdfs:label>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A relation between a functional location specification and a BFO function such that the specification prescribes that the function must be realized by equipment installed at the associated functional location.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma relação entre uma especificação de local de instalação e uma função BFO tal que a especificação prescreve que a função deve ser realizada pelo equipamento instalado no local de instalação associado.</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000029 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000029">
        <rdfs:domain rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
        <rdfs:range rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000027"/>
        <rdfs:label xml:lang="pt-br">requer papel</rdfs:label>
        <rdfs:label xml:lang="en">requires role</rdfs:label>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A relation between a functional location and a required role such that equipment installed at the functional location must bear the specified role.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma relação entre um local de instalação e um papel requerido tal que o equipamento instalado no local de instalação deve portar o papel especificado.</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000031 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000031">
        <rdfs:domain rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000005"/>
        <rdfs:range rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
        <rdfs:label xml:lang="pt-br">especifica local de instalação</rdfs:label>
        <rdfs:label xml:lang="en">specifies location</rdfs:label>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A relation between a functional location specification and a functional location such that the specification prescribes the required function and technical constraints at the functional location.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma relação entre uma especificação de local de instalação e um local de instalação tal que a especificação prescreve a função requerida e as restrições técnicas no local de instalação.</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000007 -->

    <owl:DatatypeProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000007">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:label xml:lang="en">has coordinate X</rdfs:label>
        <rdfs:label xml:lang="pt-br">tem coordenada X</rdfs:label>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">The X coordinate of a functional location relative to a material reference frame.</iof-av:naturalLanguageDefinition>
    </owl:DatatypeProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000008 -->

    <owl:DatatypeProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000008">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:label xml:lang="en">has coordinate Y</rdfs:label>
        <rdfs:label xml:lang="pt-br">tem coordenada Y</rdfs:label>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">The Y coordinate of a functional location relative to a material reference frame.</iof-av:naturalLanguageDefinition>
    </owl:DatatypeProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000009 -->

    <owl:DatatypeProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000009">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:label xml:lang="en">has coordinate Z</rdfs:label>
        <rdfs:label xml:lang="pt-br">tem coordenada Z</rdfs:label>
        <skos:example xml:lang="en">Z: +12.6m (Deck C level on platform P-74)</skos:example>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">The Z coordinate (elevation) of a functional location relative to a material reference frame.</iof-av:naturalLanguageDefinition>
    </owl:DatatypeProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000010 -->

    <owl:DatatypeProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000010">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000035"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">has series label</rdfs:label>
        <rdfs:label xml:lang="pt-br">tem rótulo da série</rdfs:label>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A user-facing label for a time series dataset.</iof-av:naturalLanguageDefinition>
    </owl:DatatypeProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000018 -->

    <owl:DatatypeProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000018">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="pt-br">data de instalação</rdfs:label>
        <rdfs:label xml:lang="en">installed date</rdfs:label>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">O carimbo de tempo de quando o equipamento foi instalado em um local de instalação.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="en">The timestamp when equipment was installed at a functional location.</iof-av:naturalLanguageDefinition>
    </owl:DatatypeProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000021 -->

    <owl:DatatypeProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000021">
        <rdfs:domain rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000020"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">note text</rdfs:label>
        <rdfs:label xml:lang="pt-br">texto da nota</rdfs:label>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
    </owl:DatatypeProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000022 -->

    <owl:DatatypeProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000022">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000020"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="pt-br">carimbo de tempo da nota</rdfs:label>
        <rdfs:label xml:lang="en">note timestamp</rdfs:label>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
    </owl:DatatypeProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000026 -->

    <owl:DatatypeProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000026">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="pt-br">data de remoção</rdfs:label>
        <rdfs:label xml:lang="en">removed date</rdfs:label>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">O carimbo de tempo de quando o equipamento foi removido de um local de instalação. A ausência indica que o equipamento está atualmente instalado.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="en">The timestamp when equipment was removed from a functional location. Absence indicates equipment is currently installed.</iof-av:naturalLanguageDefinition>
    </owl:DatatypeProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000032 -->

    <owl:DatatypeProperty rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000032">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000035"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label xml:lang="pt-br">armazenado em</rdfs:label>
        <rdfs:label xml:lang="en">stored at</rdfs:label>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">The URI of the storage system where time series data is physically stored.</iof-av:naturalLanguageDefinition>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/APOLLO_SV_00000796 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/APOLLO_SV_00000796">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/COB_0000035"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000035"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A planned process that has a data set as its specified output.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">dataset creating</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000001">
        <rdfs:label xml:lang="en">entity</rdfs:label>
        <skos:example xml:lang="en">Julius Caesar; the Second World War; your body mass index; Verdi&apos;s Requiem</skos:example>
        <skos:prefLabel xml:lang="en">entity</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <owl:disjointWith>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
            </owl:Restriction>
        </owl:disjointWith>
        <obo:IAO_0000115 xml:lang="en">An entity that exists in full at any time in which it exists at all, persists through time while maintaining its identity and has no temporal parts.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">continuant</rdfs:label>
        <skos:example xml:lang="en">A human being; a tennis ball; a cave; a region of space; someone&apos;s temperature</skos:example>
        <skos:prefLabel xml:lang="en">continuant</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <owl:disjointWith>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
            </owl:Restriction>
        </owl:disjointWith>
        <obo:IAO_0000115 xml:lang="en">An entity that has temporal parts and that happens, unfolds or develops through time.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">occurrent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:label xml:lang="en">independent continuant</rdfs:label>
        <skos:example xml:lang="en">An atom; a molecule; an organism; a heart; a chair; the bottom right portion of a human torso; a leg; the interior of your mouth; a spatial region; an orchestra</skos:example>
        <skos:prefLabel xml:lang="en">independent continuant</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000141"/>
        <rdfs:label xml:lang="en">spatial region</rdfs:label>
        <skos:example xml:lang="en">As for zero-dimensional spatial region, one-dimensional spatial region, two-dimensional spatial region, three-dimensional spatial region</skos:example>
        <skos:prefLabel xml:lang="en">spatial region</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:label xml:lang="en">process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:label xml:lang="en">disposition</rdfs:label>
        <skos:altLabel xml:lang="en">internally-grounded realizable entity</skos:altLabel>
        <skos:example xml:lang="en">An atom of element X has the disposition to decay to an atom of element Y; the cell wall is disposed to transport cellular material through endocytosis and exocytosis; certain people have a predisposition to colon cancer; children are innately disposed to categorize objects in certain ways</skos:example>
        <skos:prefLabel xml:lang="en">disposition</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <obo:IAO_0000115 xml:lang="en">A specifically dependent continuant  that inheres in continuant  entities and are not exhibited in full at every time in which it inheres in an entity or group of entities. The exhibition or actualization of a realizable entity is a particular manifestation, functioning or process that occurs under certain circumstances.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">realizable entity</rdfs:label>
        <skos:example xml:lang="en">The role of being a doctor; the role of this boundary to delineate where Utah and Colorado meet; the function of your reproductive organs; the disposition of your blood to coagulate; the disposition of this piece of metal to conduct electricity</skos:example>
        <skos:prefLabel xml:lang="en">realizable entity</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <rdfs:label xml:lang="en">quality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:label xml:lang="en">specifically dependent continuant</rdfs:label>
        <skos:example xml:lang="en">(with multiple bearers) John&apos;s love for Mary; the ownership relation between John and this statue; the relation of authority between John and his subordinates</skos:example>
        <skos:example xml:lang="en">(with one bearer) The mass of this tomato; the pink colour of a medium rare piece of grilled filet mignon at its centre; the smell of this portion of mozzarella; the disposition of this fish to decay; the role of being a doctor; the function of this heart to pump blood; the shape of this hole</skos:example>
        <skos:prefLabel xml:lang="en">specifically dependent continuant</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <obo:IAO_0000115 xml:lang="en">A realizable entity  the manifestation of which brings about some result or end that is not essential to a continuant  in virtue of the kind of thing that it is but that can be served or participated in by that kind of continuant  in some kinds of natural, social or institutional contexts.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">role</rdfs:label>
        <skos:altLabel xml:lang="en">externally-grounded realizable entity</skos:altLabel>
        <skos:example xml:lang="en">The priest role; the student role; the role of subject in a clinical trial; the role of a stone in marking a property boundary; the role of a boundary to demarcate two neighbouring administrative territories; the role of a building in serving as a military target</skos:example>
        <skos:prefLabel xml:lang="en">role</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000141"/>
        <rdfs:label xml:lang="en">site</rdfs:label>
        <skos:example xml:lang="en">A hole in a portion of cheese; a rabbit hole; the Grand Canyon; the Piazza San Marco; the kangaroo-joey-containing hole of a kangaroo pouch; your left nostril (a fiat part - the opening - of your left nasal cavity); the lumen of your gut; the hold of a ship; the interior of the trunk of your car; hole in an engineered floor joist</skos:example>
        <skos:example xml:lang="en-us">location of a container, floor area in a factory building, location of a machine (relative to the coordinate of a factory floor), location on a shelf in a warehouse</skos:example>
        <skos:prefLabel xml:lang="en">site</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:label xml:lang="en">generically dependent continuant</rdfs:label>
        <skos:altLabel xml:lang="en">g-dependent continuant</skos:altLabel>
        <skos:example xml:lang="en">The pdf file on your laptop; the pdf file that is a copy thereof on my laptop; the sequence of this protein molecule; the sequence that is a copy thereof in that protein molecule; the content that is shared by a string of dots and dashes written on a page and the transmitted Morse code signal; the content of a sentence; an engineering blueprint</skos:example>
        <skos:prefLabel xml:lang="en">generically dependent continuant</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000034 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000034">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/Capability"/>
        <rdfs:label xml:lang="en">function</rdfs:label>
        <skos:example xml:lang="en">The function of a hammer to drive in nails; the function of a heart pacemaker to regulate the beating of a heart through electricity</skos:example>
        <skos:prefLabel xml:lang="en">function</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000141"/>
        <obo:IAO_0000115 xml:lang="en">An independent continuant that is spatially extended whose identity is independent of that of other entities and can be maintained through time.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">material entity</rdfs:label>
        <skos:example xml:lang="en">A human being; the undetached arm of a human being; an aggregate of human beings</skos:example>
        <skos:prefLabel xml:lang="en">material entity</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000140 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000140">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000141"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000124"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000140"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">continuant fiat boundary</rdfs:label>
        <skos:example xml:lang="en">As for fiat point, fiat line, fiat surface</skos:example>
        <skos:prefLabel xml:lang="en">continuant fiat boundary</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000141 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:label xml:lang="en">immaterial entity</rdfs:label>
        <skos:example xml:lang="en">As for fiat point, fiat line, fiat surface, site</skos:example>
        <skos:prefLabel xml:lang="en">immaterial entity</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/COB_0000035 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/COB_0000035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <rdfs:label xml:lang="en">completely executed planned process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/COB_0000082 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/COB_0000082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115 xml:lang="en">A process that is initiated by an agent who intends to carry out a plan to achieve an objective through one or more actions as described in a plan specification.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">planned process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is intended to be one or more truthful statement(s) about something (modulo, e.g., measurement precision or other systematic errors) and is constructed/acquired by a method which reliably tends to produce (approximately) truthful statements.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">data entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is a mark(s) or character(s) used as a conventional representation of another entity.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">symbol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A generically dependent continuant that is about some thing.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">information content entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An information content entity whose concretizations indicate to their bearer how to realize them in a process.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">directive information entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000078 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000078">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000002"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000120"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000121"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000122"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000123"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000124"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000125"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000423"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000428"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000102"/>
        <obo:IAO_0000115 xml:lang="en">The curation status of the term. The allowed values come from an enumerated list of predefined terms. See the specification of these instances for more detailed definitions of each enumerated value.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">curation status specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000100 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000100">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0001000"/>
        <obo:IAO_0000115 xml:lang="en">A data item that is an aggregate of other data items of the same type that have something in common. Averages and distributions can be determined for data sets.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">homogenous data collection</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000102 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000102">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <obo:IAO_0000115 xml:lang="en">Data about an ontology part is a data item about a part of an ontology, for example a term</obo:IAO_0000115>
        <rdfs:label xml:lang="en">data about an ontology part</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000225 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000225">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000103"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000226"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000227"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000228"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000229"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OMO_0001000"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000102"/>
        <obo:IAO_0000115 xml:lang="en">The reason for which a term has been deprecated. The allowed values come from an enumerated list of predefined terms. See the specification of these instances for more detailed definitions of each enumerated value.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">obsolescence reason specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000409 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000409">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000410"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000420"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000421"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000102"/>
        <obo:IAO_0000115 xml:lang="en">A denotator type indicates how a term should be interpreted from an ontological perspective.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">denotator type</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000577 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000577">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000028"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000578"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A symbol that is part of a CRID and that is sufficient to look up a record from the CRID&apos;s registry.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">centrally registered identifier symbol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000578 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000578">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000577"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000219"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000579"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An information content entity that consists of a CRID symbol and additional information about the CRID registry to which it belongs.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">centrally registered identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000579 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000579">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020020"/>
        <obo:IAO_0000115 xml:lang="en">A code set of CRID records, each consisting of a CRID symbol and additional information which was recorded in the code set through an assigning a centrally registered identifier process.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">centrally registered identifier registry</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0001000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0001000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <obo:IAO_0000115 xml:lang="en">A data entity that consists of multiple data entities.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">data collection</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0020000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0020000">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000030"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000219"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0020010"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000219"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0020010"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is the outcome of a dubbing process and is used to refer to one instance of entity shared by a group of people to refer to that individual entity.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0020010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0020010">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/COB_0000035"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000035"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A planned process that provides a reference to an individual entity shared by a group of subscribers to refer to that individual entity.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">identifier creating process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0020020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0020020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is a collection of other information content entities that has been created to identify or annotate things in a specified domain, and where the intention of its creators is that the collection has a one-to-one correspondence with those things.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">code set</rdfs:label>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MaterialArtifact -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact">
        <owl:disjointWith rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/core/Core/Capability -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/core/Core/Capability">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <rdfs:label xml:lang="en-us">capability</rdfs:label>
        <skos:example xml:lang="en-us">Capability of a person to play chess at the &quot;master&quot; level; of a team to play football in the professional league; of a lathe to turn at maximal speed of 4,000 RPM; or of your digestive system to digest tiramisu.</skos:example>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/MaturityLevel -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/MaturityLevel">
        <rdfs:label xml:lang="en-us">maturity level</rdfs:label>
    </owl:Class>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000001 -->

    <owl:Class rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000578"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000015"/>
                <owl:someValuesFrom rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000015"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000004"/>
        <rdfs:label xml:lang="en">Equipment Tag</rdfs:label>
        <rdfs:label xml:lang="pt-br">Tag de Equipamento</rdfs:label>
        <skos:altLabel xml:lang="en">Tag</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">Tag</skos:altLabel>
        <skos:example xml:lang="pt-br">PT-23424 (posição de transmissor de pressão)</skos:example>
        <skos:example xml:lang="en">PT-23424 (pressure transmitter position)</skos:example>
        <skos:example xml:lang="en">XV-23423 (control valve position)</skos:example>
        <skos:prefLabel xml:lang="en">Equipment Tag</skos:prefLabel>
        <skos:prefLabel xml:lang="pt-br">Tag de Equipamento</skos:prefLabel>
        <iof-av:explanatoryNote xml:lang="pt-br">Convenções de prefixo da tag: XV = válvula de controle, PSV = válvula de segurança de pressão, PT = transmissor de pressão, FT = transmissor de vazão, LV = válvula de nível. Estes são resumos convencionalizados da classificação funcional da especificação, mas não substituem a especificação.</iof-av:explanatoryNote>
        <iof-av:explanatoryNote xml:lang="en">Tag prefix conventions: XV = control valve, PSV = pressure safety valve, PT = pressure transmitter, FT = flow transmitter, LV = level valve. These are conventionalized summaries of the specification&apos;s functional classification but do not replace the specification.</iof-av:explanatoryNote>
        <iof-av:firstOrderLogicDefinition xml:lang="en">EquipmentTag(x) → Identifier(x) ∧ ∃!y(FunctionalLocation(y) ∧ identifiesLocation(x,y)) ∧ ¬FunctionalLocationCode(x)</iof-av:firstOrderLogicDefinition>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">An equipment tag is an identifier that denotes a functional location through industrial naming conventions, where the tag prefix encodes the expected equipment type at the position. The tag does not denote the physical equipment — the relationship between tag and equipment is mediated through the functional location.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma tag de equipamento é um identificador que denota um local de instalação através de convenções industriais de nomenclatura, onde o prefixo da tag codifica o tipo esperado de equipamento na posição. A tag não denota o equipamento físico — a relação entre tag e equipamento é mediada pelo local de instalação.</iof-av:naturalLanguageDefinition>
        <iof-av:semiFormalNaturalLanguageDefinition xml:lang="en">every instance of EquipmentTag is an instance of iao:CentrallyRegisteredIdentifier that identifiesLocation exactly one FunctionalLocation and that is disjoint from FunctionalLocationCode</iof-av:semiFormalNaturalLanguageDefinition>
        <iof-av:usageNote xml:lang="pt-br">Quando engenheiros dizem &apos;válvula XV-23424&apos;, eles usam a tag de equipamento como uma abreviação pragmática para &apos;o equipamento atualmente instalado na posição denotada por XV-23424&apos;.</iof-av:usageNote>
        <iof-av:usageNote xml:lang="en">When engineers say &apos;valve XV-23424&apos;, they use the equipment tag as a pragmatic shorthand for &apos;the equipment currently installed at the position denoted by XV-23424&apos;.</iof-av:usageNote>
    </owl:Class>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000002 -->

    <owl:Class rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000002">
        <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000023"/>
                <owl:someValuesFrom rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Equipment Unit Site</rdfs:label>
        <rdfs:label xml:lang="pt-br">Sítio da Unidade de Equipamento</rdfs:label>
        <iof-av:adaptedFrom xml:lang="en">ISO 14224:2016 Level 4: Equipment Unit</iof-av:adaptedFrom>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">An equipment unit site is a functional location that represents a unit within a subsystem in the ISO 14224 hierarchy.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um sítio da unidade de equipamento é um local de instalação que representa uma unidade dentro de um subsistema na hierarquia ISO 14224.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003 -->

    <owl:Class rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000006"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Functional Location</rdfs:label>
        <rdfs:label xml:lang="pt-br">Local de Instalação</rdfs:label>
        <rdfs:seeAlso xml:lang="en">CQ1: Current equipment assignment</rdfs:seeAlso>
        <rdfs:seeAlso xml:lang="en">CQ3: Hierarchical navigation</rdfs:seeAlso>
        <rdfs:seeAlso xml:lang="en">CQ5: Spatial proximity</rdfs:seeAlso>
        <skos:altLabel xml:lang="en">FL</skos:altLabel>
        <skos:altLabel xml:lang="pt-br">LI</skos:altLabel>
        <skos:example xml:lang="en">Site for pressure transmitter PT-23424 in gas dehydration system</skos:example>
        <skos:example xml:lang="pt-br">Sítio para o transmissor de pressão PT-23424 no sistema de desidratação de gás</skos:example>
        <skos:prefLabel xml:lang="en">Functional Location</skos:prefLabel>
        <skos:prefLabel xml:lang="pt-br">Local de Instalação</skos:prefLabel>
        <iof-av:adaptedFrom xml:lang="en">ISO 14224:2016 — &apos;a position in a functional hierarchy where a maintainable item is or can be installed&apos;</iof-av:adaptedFrom>
        <iof-av:explanatoryNote xml:lang="pt-br">A escolha de bfo:Site como categoria de fundamentação resulta de uma eliminação sistemática de alternativas: MaterialEntity falha na persistência quando vazio, Role falha na persistência (requer portador), InformationContentEntity falha nas consultas espaciais, SpatialRegion falha na relatividade à estrutura da planta. Somente Site satisfaz todos os requisitos simultaneamente.</iof-av:explanatoryNote>
        <iof-av:explanatoryNote xml:lang="en">The choice of bfo:Site as the grounding category results from a systematic elimination of alternatives: MaterialEntity fails persistence when empty, Role fails persistence (requires bearer), InformationContentEntity fails spatial queries, SpatialRegion fails relativity to plant structure. Only Site satisfies all requirements simultaneously.</iof-av:explanatoryNote>
        <iof-av:firstOrderLogicDefinition xml:lang="en">FunctionalLocation(x) → Site(x) ∧ ∃y(MaterialEntity(y) ∧ hasBoundaryDeterminedBy(x,y)) ∧ ¬MaterialArtifact(x)</iof-av:firstOrderLogicDefinition>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A functional location is a site that is a persistent spatial position in an industrial facility hierarchy where a maintainable item is or can be installed, and whose boundaries are determined in relation to delimiting material structures rather than by the equipment that may occupy it.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um local de instalação é um sítio que é uma posição espacial persistente em uma hierarquia de instalação industrial onde um item manutenível está ou pode ser instalado, e cujos limites são determinados em relação a estruturas materiais delimitadoras e não pelo equipamento que possa ocupá-lo.</iof-av:naturalLanguageDefinition>
        <iof-av:semiFormalNaturalLanguageDefinition xml:lang="en">every instance of FunctionalLocation is an instance of bfo:Site that (1) has its boundaries determined by some MaterialEntity, (2) persists independently of whether any Equipment is installed at it, and (3) participates in an ISO 14224 hierarchical decomposition via partOfSystemSite</iof-av:semiFormalNaturalLanguageDefinition>
        <iof-av:synonym xml:lang="en">Installation Position</iof-av:synonym>
        <iof-av:synonym xml:lang="pt-br">Posição de Instalação</iof-av:synonym>
        <iof-av:synonym xml:lang="en">Tag Location</iof-av:synonym>
        <iof-av:usageNote xml:lang="en">A functional location persists when empty — when equipment is removed, the inlet/outlet nozzles and foundation bolts remain, so the site boundaries remain anchored.</iof-av:usageNote>
        <iof-av:usageNote xml:lang="pt-br">Um local de instalação persiste quando vazio — quando o equipamento é removido, os bocais de entrada/saída e os parafusos de fundação permanecem, então os limites do sítio permanecem ancorados.</iof-av:usageNote>
    </owl:Class>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000004 -->

    <owl:Class rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000578"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000014"/>
                <owl:someValuesFrom rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000014"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="pt-br">Código do Local de Instalação</rdfs:label>
        <rdfs:label xml:lang="en">Functional Location Code</rdfs:label>
        <skos:altLabel xml:lang="pt-br">Código LI</skos:altLabel>
        <skos:altLabel xml:lang="en">FL Code</skos:altLabel>
        <skos:example xml:lang="en">30142.FSGE.FEW.10.01.1</skos:example>
        <skos:example xml:lang="en">30234.FSFS.FWSF.10.01.01</skos:example>
        <skos:prefLabel xml:lang="pt-br">Código do Local de Instalação</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Functional Location Code</skos:prefLabel>
        <iof-av:adaptedFrom xml:lang="en">ISO 14224:2016 — five-level hierarchical coding scheme</iof-av:adaptedFrom>
        <iof-av:explanatoryNote xml:lang="en">Distinct from EquipmentTag: the FL code encodes organizational hierarchy (WHERE in the structure), while the equipment tag encodes functional designation (WHAT type of equipment is expected). Both denote the same functional location.</iof-av:explanatoryNote>
        <iof-av:explanatoryNote xml:lang="pt-br">Distinto da Tag de Equipamento: o código LI codifica a hierarquia organizacional (ONDE na estrutura), enquanto a tag de equipamento codifica a designação funcional (QUE tipo de equipamento é esperado). Ambos denotam o mesmo local de instalação.</iof-av:explanatoryNote>
        <iof-av:firstOrderLogicDefinition xml:lang="en">FunctionalLocationCode(x) → Identifier(x) ∧ ∃!y(FunctionalLocation(y) ∧ identifies(x,y)) ∧ ¬EquipmentTag(x)</iof-av:firstOrderLogicDefinition>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A functional location code is an identifier that denotes a functional location by encoding the position&apos;s place in the ISO 14224 organizational hierarchy, with segments representing plant, system, subsystem, equipment unit, and maintainable item levels.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um código de local de instalação é um identificador que denota um local de instalação codificando a posição do local na hierarquia organizacional ISO 14224, com segmentos representando os níveis de planta, sistema, subsistema, unidade de equipamento e item manutenível.</iof-av:naturalLanguageDefinition>
        <iof-av:semiFormalNaturalLanguageDefinition xml:lang="en">every instance of FunctionalLocationCode is an instance of iao:CentrallyRegisteredIdentifier that identifies exactly one FunctionalLocation and that is disjoint from EquipmentTag</iof-av:semiFormalNaturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000005 -->

    <owl:Class rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000031"/>
                <owl:someValuesFrom rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="pt-br">Especificação do Local de Instalação</rdfs:label>
        <rdfs:label xml:lang="en">Functional Location Specification</rdfs:label>
        <skos:example xml:lang="pt-br">Especificação requerendo função de medição de pressão, faixa 0-350 bar, ATEX Zona 1</skos:example>
        <skos:example xml:lang="en">Spec requiring pressure sensing function, range 0-350 bar, ATEX Zone 1</skos:example>
        <skos:prefLabel xml:lang="pt-br">Especificação do Local de Instalação</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Functional Location Specification</skos:prefLabel>
        <iof-av:explanatoryNote xml:lang="pt-br">Relacionada mas distinta da Tag de Equipamento: duas posições podem compartilhar o mesmo prefixo de tag (ex., ambas XV-) enquanto possuem especificações diferentes (uma classificada para 150 bar, outra para 300 bar). Corresponde a IDO lis:Specified no mapeamento IDO.</iof-av:explanatoryNote>
        <iof-av:explanatoryNote xml:lang="en">Related to but distinct from EquipmentTag: two positions may share the same tag prefix (e.g., both XV-) while having different specifications (one rated for 150 bar, another for 300 bar). Corresponds to IDO lis:Specified in the IDO mapping.</iof-av:explanatoryNote>
        <iof-av:firstOrderLogicDefinition xml:lang="en">FunctionalLocationSpecification(x) → DirectiveInformationEntity(x) ∧ ∃y(FunctionalLocation(y) ∧ specifiesLocation(x,y)) ∧ ∃z(Function(z) ∧ requiresFunction(x,z))</iof-av:firstOrderLogicDefinition>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A functional location specification is a directive information entity that prescribes the required function and technical constraints (such as pressure ratings, material requirements, and interface dimensions) at a functional location. Specifications persist independently of installed equipment and may evolve over the plant lifecycle.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma especificação de local de instalação é uma entidade informacional diretiva que prescreve a função requerida e as restrições técnicas (tais como classificações de pressão, requisitos de material e dimensões de interface) em um local de instalação. Especificações persistem independentemente do equipamento instalado e podem evoluir ao longo do ciclo de vida da planta.</iof-av:naturalLanguageDefinition>
        <iof-av:semiFormalNaturalLanguageDefinition xml:lang="en">every instance of FunctionalLocationSpecification is an instance of iao:DirectiveInformationEntity that specifiesLocation some FunctionalLocation and requiresFunction some bfo:Function</iof-av:semiFormalNaturalLanguageDefinition>
        <iof-av:synonym xml:lang="pt-br">Especificação LI</iof-av:synonym>
        <iof-av:synonym xml:lang="en">FL Specification</iof-av:synonym>
    </owl:Class>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000019 -->

    <owl:Class rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000019">
        <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000023"/>
                <owl:someValuesFrom rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000002"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Maintainable Item Site</rdfs:label>
        <rdfs:label xml:lang="pt-br">Sítio do Item Manutenível</rdfs:label>
        <skos:example xml:lang="en">Site for individual sensor PT-23424</skos:example>
        <skos:example xml:lang="pt-br">Sítio para o sensor individual PT-23424</skos:example>
        <iof-av:adaptedFrom xml:lang="en">ISO 14224:2016 Level 5: Maintainable Item</iof-av:adaptedFrom>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A maintainable item site is a functional location that is the lowest level in the ISO 14224 hierarchy where a single maintainable item is or can be installed.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um sítio do item manutenível é um local de instalação que é o nível mais baixo na hierarquia ISO 14224 onde um único item manutenível está ou pode ser instalado.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000020 -->

    <owl:Class rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
        <rdfs:label xml:lang="en">Maintenance Note</rdfs:label>
        <rdfs:label xml:lang="pt-br">Nota de Manutenção</rdfs:label>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A maintenance note is a data item that is a textual record created during maintenance work, anchored to a functional location rather than to equipment for persistence across replacements.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma nota de manutenção é um item de dado que é um registro textual criado durante trabalho de manutenção, ancorado a um local de instalação ao invés de ao equipamento para persistência através de substituições.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000025 -->

    <owl:Class rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000025">
        <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
        <rdfs:label xml:lang="en">Plant Site</rdfs:label>
        <rdfs:label xml:lang="pt-br">Sítio da Planta</rdfs:label>
        <skos:example xml:lang="en">Offshore platform P-74</skos:example>
        <skos:example xml:lang="pt-br">Plataforma offshore P-74</skos:example>
        <iof-av:adaptedFrom xml:lang="en">ISO 14224:2016 Level 1: Plant</iof-av:adaptedFrom>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A plant site is a functional location that is the highest level in the ISO 14224 hierarchy, representing an entire industrial plant or facility.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um sítio da planta é um local de instalação que é o nível mais alto na hierarquia ISO 14224, representando uma planta ou instalação industrial inteira.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000027 -->

    <owl:Class rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:label xml:lang="pt-br">Papel Requerido</rdfs:label>
        <rdfs:label xml:lang="en">Required Role</rdfs:label>
        <skos:example xml:lang="pt-br">Papel de estrangulamento variável, papel de controle de alta pressão</skos:example>
        <skos:example xml:lang="en">Variable choking role, high-pressure control role</skos:example>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A required role is a BFO role that specifies the functional requirements for equipment at a functional location.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um papel requerido é um papel BFO que especifica os requisitos funcionais para equipamento em um local de instalação.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000030 -->

    <owl:Class rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000030">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
        <rdfs:label xml:lang="en">Sensor</rdfs:label>
        <rdfs:label xml:lang="pt-br">Sensor</rdfs:label>
        <skos:example xml:lang="en">Pressure sensor installed at position PT-23424</skos:example>
        <skos:example xml:lang="pt-br">Sensor de pressão instalado na posição PT-23424</skos:example>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A sensor is an equipment item that measures physical properties such as pressure, temperature, or flow.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um sensor é um item de equipamento que mede propriedades físicas tais como pressão, temperatura ou vazão.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000033 -->

    <owl:Class rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000033">
        <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000023"/>
                <owl:someValuesFrom rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000034"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Subsystem Site</rdfs:label>
        <rdfs:label xml:lang="pt-br">Sítio do Subsistema</rdfs:label>
        <skos:example xml:lang="en">Inlet Separator subsystem site within Gas Dehydration System</skos:example>
        <iof-av:adaptedFrom xml:lang="en">ISO 14224:2016 Level 3: Subsystem</iof-av:adaptedFrom>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A subsystem site is a functional location that represents a subsystem within a system in the ISO 14224 hierarchy.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um sítio do subsistema é um local de instalação que representa um subsistema dentro de um sistema na hierarquia ISO 14224.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000034 -->

    <owl:Class rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000034">
        <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000023"/>
                <owl:someValuesFrom rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000025"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">System Site</rdfs:label>
        <rdfs:label xml:lang="pt-br">Sítio do Sistema</rdfs:label>
        <skos:example xml:lang="en">Gas Dehydration System site within platform P-74</skos:example>
        <skos:example xml:lang="pt-br">Sítio do Sistema de Desidratação de Gás dentro da plataforma P-74</skos:example>
        <iof-av:adaptedFrom xml:lang="en">ISO 14224:2016 Level 2: System</iof-av:adaptedFrom>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A system site is a functional location that represents a major system within a plant in the ISO 14224 hierarchy.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um sítio do sistema é um local de instalação que representa um sistema principal dentro de uma planta na hierarquia ISO 14224.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000035 -->

    <owl:Class rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
        <rdfs:label xml:lang="pt-br">Conjunto de Dados Medidos com Carimbo de Tempo</rdfs:label>
        <rdfs:label xml:lang="en">Time-Stamped Measured Dataset</rdfs:label>
        <rdfs:seeAlso xml:lang="en">CQ2: Temporal continuity across equipment replacements</rdfs:seeAlso>
        <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
        <iof-av:naturalLanguageDefinition xml:lang="en">A time-stamped measured dataset is a data item that contains time-series observations indexed by a functional location for persistent data anchoring across equipment replacements.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um conjunto de dados medidos com carimbo de tempo é um item de dado que contém observações de séries temporais indexadas por um local de instalação para ancoragem persistente de dados através de substituições de equipamento.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


