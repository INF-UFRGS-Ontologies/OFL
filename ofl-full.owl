    <!-- http://purl.obolibrary.org/obo/IAO_0000229 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/IAO_0000229">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000225"/>
