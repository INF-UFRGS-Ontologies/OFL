ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000124> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/BFO_0000004> ObjectComplementOf(<http://purl.obolibrary.org/obo/BFO_0000006>)))

