AnnotationAssertion(rdfs:label ofl:OFL_0000008 "has coordinate Y"@en)
AnnotationAssertion(rdfs:label ofl:OFL_0000008 "tem coordenada Y"@pt-br)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000008 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000008 "The Y coordinate of a functional location relative to a material reference frame."@en)
FunctionalDataProperty(ofl:OFL_0000008)
DataPropertyDomain(ofl:OFL_0000008 ofl:OFL_0000003)
DataPropertyRange(ofl:OFL_0000008 xsd:double)

# Data Property: ofl:OFL_0000009 (tem coordenada Z)

AnnotationAssertion(rdfs:label ofl:OFL_0000009 "has coordinate Z"@en)
AnnotationAssertion(rdfs:label ofl:OFL_0000009 "tem coordenada Z"@pt-br)
AnnotationAssertion(skos:example ofl:OFL_0000009 "Z: +12.6m (Deck C level on platform P-74)"@en)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000009 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000009 "The Z coordinate (elevation) of a functional location relative to a material reference frame."@en)
FunctionalDataProperty(ofl:OFL_0000009)
DataPropertyDomain(ofl:OFL_0000009 ofl:OFL_0000003)
DataPropertyRange(ofl:OFL_0000009 xsd:double)

