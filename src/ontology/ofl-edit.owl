############################
#   Annotation Properties
############################

AnnotationAssertion(rdfs:label dcterms:description "description")
AnnotationAssertion(rdfs:label dcterms:license "license")
AnnotationAssertion(rdfs:label dcterms:title "title")


############################
#   Object Properties
############################

# Object Property: ofl:OFL_0000006 (tem limite determinado por)

AnnotationAssertion(rdfs:label ofl:OFL_0000006 "has boundary determined by"@en)
AnnotationAssertion(rdfs:label ofl:OFL_0000006 "tem limite determinado por"@pt-br)
AnnotationAssertion(skos:example ofl:OFL_0000006 "FL_PT23424_Site hasBoundaryDeterminedBy DeckC_Structure"@en)
AnnotationAssertion(iof-av:firstOrderLogicDefinition ofl:OFL_0000006 "hasBoundaryDeterminedBy(x,y) → FunctionalLocation(x) ∧ MaterialEntity(y) ∧ boundaryOf(x) determinedInRelationTo(y)"@en)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000006 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000006 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000006 "A relation between a functional location and a material entity such that the material entity provides the reference frame that determines the spatial boundaries of the functional location."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000006 "Uma relação entre um local de instalação e uma entidade material tal que a entidade material fornece o referencial que determina os limites espaciais do local de instalação."@pt-br)
AnnotationAssertion(iof-av:semiFormalNaturalLanguageDefinition ofl:OFL_0000006 "if x hasBoundaryDeterminedBy y then x is a FunctionalLocation and y is a MaterialEntity and the spatial boundaries of x are determined in relation to y"@en)
AnnotationAssertion(iof-av:usageNote ofl:OFL_0000006 "Implements BFO site semantics: site boundaries are determined in relation to material entities but not by coincidence with those entities."@en)
ObjectPropertyDomain(ofl:OFL_0000006 ofl:OFL_0000003)
ObjectPropertyRange(ofl:OFL_0000006 <http://purl.obolibrary.org/obo/BFO_0000040>)

# Object Property: ofl:OFL_0000011 (tem parte de sítio do sistema)

AnnotationAssertion(rdfs:label ofl:OFL_0000011 "has system site part"@en)
AnnotationAssertion(rdfs:label ofl:OFL_0000011 "tem parte de sítio do sistema"@pt-br)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000011 iof-ind:Provisional)
InverseObjectProperties(ofl:OFL_0000011 ofl:OFL_0000023)

# Object Property: ofl:OFL_0000012 (has tag)

AnnotationAssertion(rdfs:label ofl:OFL_0000012 "has tag"@en)
AnnotationAssertion(rdfs:label ofl:OFL_0000012 "tem tag"@pt-br)
AnnotationAssertion(iof-av:explanatoryNote ofl:OFL_0000012 "Esta relação captura a abreviação pragmática industrial onde engenheiros dizem 'válvula XV-23424' para significar 'a válvula atualmente instalada na posição denotada por XV-23424'. A tag não denota o equipamento — denota a posição."@pt-br)
AnnotationAssertion(iof-av:explanatoryNote ofl:OFL_0000012 "This relation captures the industrial pragmatic shorthand where engineers say 'valve XV-23424' to mean 'the valve currently installed at the position denoted by XV-23424'. The tag does not denote the equipment — it denotes the position."@en)
AnnotationAssertion(iof-av:firstOrderLogicDefinition ofl:OFL_0000012 "hasTag(x,y) ↔ ∃z(FunctionalLocation(z) ∧ installedAt(x,z) ∧ identifiesLocation(y,z))"@en)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000012 "false"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000012 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000012 "A derived relation between equipment and an equipment tag such that the equipment is installed at the functional location identified by the tag. This relation is not asserted but entailed through a property chain: equipment is installedAt a FunctionalLocation, and the EquipmentTag identifiesLocation that same FunctionalLocation."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000012 "Uma relação derivada entre um equipamento e uma tag de equipamento tal que o equipamento está instalado no local de instalação identificado pela tag. Esta relação não é assertada, mas inferida por uma cadeia de propriedades: o equipamento está installedAt um FunctionalLocation, e a EquipmentTag identifiesLocation o mesmo FunctionalLocation."@pt-br)
AnnotationAssertion(iof-av:semiFormalNaturalLanguageDefinition ofl:OFL_0000012 "if x hasTag y then there exists a FunctionalLocation z such that x installedAt z and y identifiesLocation z"@en)
ObjectPropertyDomain(ofl:OFL_0000012 iof-constr:MaterialArtifact)
ObjectPropertyRange(ofl:OFL_0000012 ofl:OFL_0000001)
SubObjectPropertyOf(ObjectPropertyChain(ofl:OFL_0000017 ObjectInverseOf(ofl:OFL_0000015)) ofl:OFL_0000012)

# Object Property: ofl:OFL_0000013 (hospedado por)

AnnotationAssertion(rdfs:label ofl:OFL_0000013 "hospedado por"@pt-br)
AnnotationAssertion(rdfs:label ofl:OFL_0000013 "hosted by"@en)
AnnotationAssertion(skos:example ofl:OFL_0000013 "Sensor PT-23424 hostedBy Valve XV-22342"@en)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000013 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000013 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000013 "A relation between a sensor and an equipment item such that the sensor is physically mounted on the equipment item. The sensor has its own functional location but is physically hosted by the equipment."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000013 "Uma relação entre um sensor e um item de equipamento tal que o sensor está fisicamente montado no item de equipamento. O sensor tem seu próprio local de instalação, mas é fisicamente hospedado pelo equipamento."@pt-br)
ObjectPropertyDomain(ofl:OFL_0000013 ofl:OFL_0000030)
ObjectPropertyRange(ofl:OFL_0000013 iof-constr:MaterialArtifact)

# Object Property: ofl:OFL_0000014 (identifies)

AnnotationAssertion(rdfs:label ofl:OFL_0000014 "identifica"@pt-br)
AnnotationAssertion(rdfs:label ofl:OFL_0000014 "identifies"@en)
AnnotationAssertion(iof-av:firstOrderLogicDefinition ofl:OFL_0000014 "identifies(x,y) → FunctionalLocationCode(x) ∧ FunctionalLocation(y) ∧ denotes(x,y) ∧ ∀z(identifies(x,z) → z = y)"@en)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000014 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000014 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000014 "A relation between a functional location code and a functional location such that the code uniquely denotes the functional location within the organizational hierarchy following the ISO 14224 coding scheme."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000014 "Uma relação entre um código de local de instalação e um local de instalação tal que o código denota unicamente o local de instalação dentro da hierarquia organizacional seguindo o esquema de codificação ISO 14224."@pt-br)
AnnotationAssertion(iof-av:semiFormalNaturalLanguageDefinition ofl:OFL_0000014 "if x identifies y then x is a FunctionalLocationCode and y is a FunctionalLocation and x uniquely denotes y"@en)
SubObjectPropertyOf(ofl:OFL_0000014 <http://purl.obolibrary.org/obo/IAO_0000219>)
FunctionalObjectProperty(ofl:OFL_0000014)
ObjectPropertyDomain(ofl:OFL_0000014 ofl:OFL_0000004)
ObjectPropertyRange(ofl:OFL_0000014 ofl:OFL_0000003)

# Object Property: ofl:OFL_0000015 (identifies location)

AnnotationAssertion(rdfs:label ofl:OFL_0000015 "identifica local de instalação"@pt-br)
AnnotationAssertion(rdfs:label ofl:OFL_0000015 "identifies location"@en)
AnnotationAssertion(iof-av:explanatoryNote ofl:OFL_0000015 "CRITICAL DESIGN DECISION: The equipment tag denotes the functional location (the position), NOT the physical equipment. The relationship between tag and equipment is mediated through the site via the hasTag property chain."@en)
AnnotationAssertion(iof-av:explanatoryNote ofl:OFL_0000015 "DECISÃO DE PROJETO CRÍTICA: A tag de equipamento denota o local de instalação (a posição), NÃO o equipamento físico. A relação entre tag e equipamento é mediada pelo sítio através da cadeia de propriedades hasTag."@pt-br)
AnnotationAssertion(iof-av:firstOrderLogicDefinition ofl:OFL_0000015 "identifiesLocation(x,y) → EquipmentTag(x) ∧ FunctionalLocation(y) ∧ denotes(x,y) ∧ ∀z(identifiesLocation(x,z) → z = y)"@en)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000015 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000015 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000015 "A relation between an equipment tag and a functional location such that the tag uniquely identifies the functional location where equipment of the designated type is or can be installed. The tag prefix convention encodes the expected equipment type at the position."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000015 "Uma relação entre uma tag de equipamento e um local de instalação tal que a tag identifica unicamente o local de instalação onde equipamento do tipo designado está ou pode ser instalado. A convenção de prefixo da tag codifica o tipo esperado de equipamento na posição."@pt-br)
AnnotationAssertion(iof-av:semiFormalNaturalLanguageDefinition ofl:OFL_0000015 "if x identifiesLocation y then x is an EquipmentTag and y is a FunctionalLocation and x denotes y"@en)
SubObjectPropertyOf(ofl:OFL_0000015 <http://purl.obolibrary.org/obo/IAO_0000219>)
FunctionalObjectProperty(ofl:OFL_0000015)
ObjectPropertyDomain(ofl:OFL_0000015 ofl:OFL_0000001)
ObjectPropertyRange(ofl:OFL_0000015 ofl:OFL_0000003)

# Object Property: ofl:OFL_0000016 (indexed by site)

AnnotationAssertion(rdfs:label ofl:OFL_0000016 "indexado por sítio"@pt-br)
AnnotationAssertion(rdfs:label ofl:OFL_0000016 "indexed by site"@en)
AnnotationAssertion(rdfs:seeAlso ofl:OFL_0000016 "CQ2: Temporal continuity across replacements"@en)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000016 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000016 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000016 "A relation between a time-stamped measured dataset and a functional location such that the dataset is indexed by the functional location rather than by individual equipment instances, enabling automatic data continuity across equipment replacements."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000016 "Uma relação entre um conjunto de dados medidos com carimbo de tempo e um local de instalação tal que o conjunto de dados é indexado pelo local de instalação ao invés de por instâncias individuais de equipamento, permitindo continuidade automática de dados através de substituições de equipamento."@pt-br)
AnnotationAssertion(iof-av:usageNote ofl:OFL_0000016 "KEY PATTERN: Enables automatic continuity without application logic to 'stitch' data from different equipment instances."@en)
FunctionalObjectProperty(ofl:OFL_0000016)
ObjectPropertyDomain(ofl:OFL_0000016 ofl:OFL_0000035)
ObjectPropertyRange(ofl:OFL_0000016 ofl:OFL_0000003)

# Object Property: ofl:OFL_0000017 (installed at)

AnnotationAssertion(rdfs:label ofl:OFL_0000017 "instalado em"@pt-br)
AnnotationAssertion(rdfs:label ofl:OFL_0000017 "installed at"@en)
AnnotationAssertion(skos:example ofl:OFL_0000017 "Sensor_PT23424_v2 installedAt FL_PT23424_Site (2017-06-16 to 2022-03-10)"@en)
AnnotationAssertion(iof-av:firstOrderLogicDefinition ofl:OFL_0000017 "installedAt(x,y) → MaterialArtifact(x) ∧ FunctionalLocation(y) ∧ ∃t(located_in(x,y,t))"@en)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000017 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000017 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000017 "A relation between a piece of equipment and a functional location such that the equipment is physically installed at the functional location during some temporally bounded period. The temporal bounds are captured via installedDate and removedDate data properties."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000017 "Uma relação entre uma peça de equipamento e um local de instalação tal que o equipamento está fisicamente instalado no local de instalação durante algum período temporalmente delimitado. Os limites temporais são capturados pelas propriedades de dados installedDate e removedDate."@pt-br)
AnnotationAssertion(iof-av:semiFormalNaturalLanguageDefinition ofl:OFL_0000017 "if x installedAt y then x is a MaterialArtifact and y is a FunctionalLocation and x is located in y at some time"@en)
SubObjectPropertyOf(ofl:OFL_0000017 <http://purl.obolibrary.org/obo/BFO_0000171>)
ObjectPropertyDomain(ofl:OFL_0000017 iof-constr:MaterialArtifact)
ObjectPropertyRange(ofl:OFL_0000017 ofl:OFL_0000003)

# Object Property: ofl:OFL_0000023 (part of system site)

AnnotationAssertion(rdfs:label ofl:OFL_0000023 "part of system site"@en)
AnnotationAssertion(rdfs:label ofl:OFL_0000023 "parte de sítio do sistema"@pt-br)
AnnotationAssertion(skos:example ofl:OFL_0000023 "MaintainableItemSite partOfSystemSite EquipmentUnitSite"@en)
AnnotationAssertion(skos:example ofl:OFL_0000023 "SubsystemSite partOfSystemSite SystemSite"@en)
AnnotationAssertion(iof-av:firstOrderLogicDefinition ofl:OFL_0000023 "partOfSystemSite(x,y) → FunctionalLocation(x) ∧ FunctionalLocation(y) ∧ partOf(x,y)"@en)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000023 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000023 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000023 "A relation between two functional locations such that the first is a proper part of the second in the ISO 14224 hierarchical decomposition. This relation is transitive, enabling queries across hierarchy levels."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000023 "Uma relação entre dois locais de instalação tal que o primeiro é parte própria do segundo na decomposição hierárquica ISO 14224. Esta relação é transitiva, permitindo consultas através dos níveis hierárquicos."@pt-br)
AnnotationAssertion(iof-av:semiFormalNaturalLanguageDefinition ofl:OFL_0000023 "if x partOfSystemSite y then x is a FunctionalLocation and y is a FunctionalLocation and x is part of y"@en)
SubObjectPropertyOf(ofl:OFL_0000023 <http://purl.obolibrary.org/obo/BFO_0000050>)
TransitiveObjectProperty(ofl:OFL_0000023)
ObjectPropertyDomain(ofl:OFL_0000023 ofl:OFL_0000003)
ObjectPropertyRange(ofl:OFL_0000023 ofl:OFL_0000003)

# Object Property: ofl:OFL_0000024 (performed at)

AnnotationAssertion(rdfs:label ofl:OFL_0000024 "performed at"@en)
AnnotationAssertion(rdfs:label ofl:OFL_0000024 "realizada em"@pt-br)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000024 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000024 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000024 "A relation between a maintenance note and a functional location such that the maintenance note documents work performed at the functional location."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000024 "Uma relação entre uma nota de manutenção e um local de instalação tal que a nota de manutenção documenta trabalho realizado no local de instalação."@pt-br)
ObjectPropertyDomain(ofl:OFL_0000024 ofl:OFL_0000020)
ObjectPropertyRange(ofl:OFL_0000024 ofl:OFL_0000003)

# Object Property: ofl:OFL_0000028 (requer função)

AnnotationAssertion(rdfs:label ofl:OFL_0000028 "requer função"@pt-br)
AnnotationAssertion(rdfs:label ofl:OFL_0000028 "requires function"@en)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000028 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000028 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000028 "A relation between a functional location specification and a BFO function such that the specification prescribes that the function must be realized by equipment installed at the associated functional location."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000028 "Uma relação entre uma especificação de local de instalação e uma função BFO tal que a especificação prescreve que a função deve ser realizada pelo equipamento instalado no local de instalação associado."@pt-br)
ObjectPropertyDomain(ofl:OFL_0000028 ofl:OFL_0000005)
ObjectPropertyRange(ofl:OFL_0000028 <http://purl.obolibrary.org/obo/BFO_0000034>)

# Object Property: ofl:OFL_0000029 (requires role)

AnnotationAssertion(rdfs:label ofl:OFL_0000029 "requer papel"@pt-br)
AnnotationAssertion(rdfs:label ofl:OFL_0000029 "requires role"@en)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000029 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000029 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000029 "A relation between a functional location and a required role such that equipment installed at the functional location must bear the specified role."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000029 "Uma relação entre um local de instalação e um papel requerido tal que o equipamento instalado no local de instalação deve portar o papel especificado."@pt-br)
ObjectPropertyDomain(ofl:OFL_0000029 ofl:OFL_0000003)
ObjectPropertyRange(ofl:OFL_0000029 ofl:OFL_0000027)

# Object Property: ofl:OFL_0000031 (especifica local de instalação)

AnnotationAssertion(rdfs:label ofl:OFL_0000031 "especifica local de instalação"@pt-br)
AnnotationAssertion(rdfs:label ofl:OFL_0000031 "specifies location"@en)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000031 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000031 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000031 "A relation between a functional location specification and a functional location such that the specification prescribes the required function and technical constraints at the functional location."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000031 "Uma relação entre uma especificação de local de instalação e um local de instalação tal que a especificação prescreve a função requerida e as restrições técnicas no local de instalação."@pt-br)
ObjectPropertyDomain(ofl:OFL_0000031 ofl:OFL_0000005)
ObjectPropertyRange(ofl:OFL_0000031 ofl:OFL_0000003)


