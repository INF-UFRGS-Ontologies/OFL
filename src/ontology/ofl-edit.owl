DataPropertyRange(ofl:OFL_0000032 xsd:anyURI)

############################
#   Classes
############################

# Class: iof-constr:MaterialArtifact (material artifact)

DisjointClasses(iof-constr:MaterialArtifact ofl:OFL_0000003)

# Class: ofl:OFL_0000001 (Tag de Equipamento)

AnnotationAssertion(rdfs:label ofl:OFL_0000001 "Equipment Tag"@en)
AnnotationAssertion(rdfs:label ofl:OFL_0000001 "Tag de Equipamento"@pt-br)
AnnotationAssertion(skos:altLabel ofl:OFL_0000001 "Tag"@en)
AnnotationAssertion(skos:altLabel ofl:OFL_0000001 "Tag"@pt-br)
AnnotationAssertion(skos:example ofl:OFL_0000001 "PT-23424 (posição de transmissor de pressão)"@pt-br)
AnnotationAssertion(skos:example ofl:OFL_0000001 "PT-23424 (pressure transmitter position)"@en)
AnnotationAssertion(skos:example ofl:OFL_0000001 "XV-23423 (control valve position)"@en)
AnnotationAssertion(skos:prefLabel ofl:OFL_0000001 "Equipment Tag"@en)
AnnotationAssertion(skos:prefLabel ofl:OFL_0000001 "Tag de Equipamento"@pt-br)
AnnotationAssertion(iof-av:explanatoryNote ofl:OFL_0000001 "Convenções de prefixo da tag: XV = válvula de controle, PSV = válvula de segurança de pressão, PT = transmissor de pressão, FT = transmissor de vazão, LV = válvula de nível. Estes são resumos convencionalizados da classificação funcional da especificação, mas não substituem a especificação."@pt-br)
AnnotationAssertion(iof-av:explanatoryNote ofl:OFL_0000001 "Tag prefix conventions: XV = control valve, PSV = pressure safety valve, PT = pressure transmitter, FT = flow transmitter, LV = level valve. These are conventionalized summaries of the specification's functional classification but do not replace the specification."@en)
AnnotationAssertion(iof-av:firstOrderLogicDefinition ofl:OFL_0000001 "EquipmentTag(x) → Identifier(x) ∧ ∃!y(FunctionalLocation(y) ∧ identifiesLocation(x,y)) ∧ ¬FunctionalLocationCode(x)"@en)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000001 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000001 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000001 "An equipment tag is an identifier that denotes a functional location through industrial naming conventions, where the tag prefix encodes the expected equipment type at the position. The tag does not denote the physical equipment — the relationship between tag and equipment is mediated through the functional location."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000001 "Uma tag de equipamento é um identificador que denota um local de instalação através de convenções industriais de nomenclatura, onde o prefixo da tag codifica o tipo esperado de equipamento na posição. A tag não denota o equipamento físico — a relação entre tag e equipamento é mediada pelo local de instalação."@pt-br)
AnnotationAssertion(iof-av:semiFormalNaturalLanguageDefinition ofl:OFL_0000001 "every instance of EquipmentTag is an instance of iao:CentrallyRegisteredIdentifier that identifiesLocation exactly one FunctionalLocation and that is disjoint from FunctionalLocationCode"@en)
AnnotationAssertion(iof-av:usageNote ofl:OFL_0000001 "Quando engenheiros dizem 'válvula XV-23424', eles usam a tag de equipamento como uma abreviação pragmática para 'o equipamento atualmente instalado na posição denotada por XV-23424'."@pt-br)
AnnotationAssertion(iof-av:usageNote ofl:OFL_0000001 "When engineers say 'valve XV-23424', they use the equipment tag as a pragmatic shorthand for 'the equipment currently installed at the position denoted by XV-23424'."@en)
SubClassOf(ofl:OFL_0000001 <http://purl.obolibrary.org/obo/IAO_0000578>)
SubClassOf(ofl:OFL_0000001 ObjectExactCardinality(1 ofl:OFL_0000015 ofl:OFL_0000003))
DisjointClasses(ofl:OFL_0000001 ofl:OFL_0000004)

# Class: ofl:OFL_0000002 (Equipment Unit Site)

AnnotationAssertion(rdfs:label ofl:OFL_0000002 "Equipment Unit Site"@en)
AnnotationAssertion(rdfs:label ofl:OFL_0000002 "Sítio da Unidade de Equipamento"@pt-br)
AnnotationAssertion(iof-av:adaptedFrom ofl:OFL_0000002 "ISO 14224:2016 Level 4: Equipment Unit"@en)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000002 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000002 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000002 "An equipment unit site is a functional location that represents a unit within a subsystem in the ISO 14224 hierarchy."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000002 "Um sítio da unidade de equipamento é um local de instalação que representa uma unidade dentro de um subsistema na hierarquia ISO 14224."@pt-br)
SubClassOf(ofl:OFL_0000002 ofl:OFL_0000003)
SubClassOf(ofl:OFL_0000002 ObjectSomeValuesFrom(ofl:OFL_0000023 ofl:OFL_0000033))
DisjointClasses(ofl:OFL_0000002 ofl:OFL_0000019 ofl:OFL_0000025 ofl:OFL_0000033 ofl:OFL_0000034)

# Class: ofl:OFL_0000003 (Local de Instalação)

AnnotationAssertion(rdfs:label ofl:OFL_0000003 "Functional Location"@en)
AnnotationAssertion(rdfs:label ofl:OFL_0000003 "Local de Instalação"@pt-br)
AnnotationAssertion(rdfs:seeAlso ofl:OFL_0000003 "CQ1: Current equipment assignment"@en)
AnnotationAssertion(rdfs:seeAlso ofl:OFL_0000003 "CQ3: Hierarchical navigation"@en)
AnnotationAssertion(rdfs:seeAlso ofl:OFL_0000003 "CQ5: Spatial proximity"@en)
AnnotationAssertion(skos:altLabel ofl:OFL_0000003 "FL"@en)
AnnotationAssertion(skos:altLabel ofl:OFL_0000003 "LI"@pt-br)
AnnotationAssertion(skos:example ofl:OFL_0000003 "Site for pressure transmitter PT-23424 in gas dehydration system"@en)
AnnotationAssertion(skos:example ofl:OFL_0000003 "Sítio para o transmissor de pressão PT-23424 no sistema de desidratação de gás"@pt-br)
AnnotationAssertion(skos:prefLabel ofl:OFL_0000003 "Functional Location"@en)
AnnotationAssertion(skos:prefLabel ofl:OFL_0000003 "Local de Instalação"@pt-br)
AnnotationAssertion(iof-av:adaptedFrom ofl:OFL_0000003 "ISO 14224:2016 — 'a position in a functional hierarchy where a maintainable item is or can be installed'"@en)
AnnotationAssertion(iof-av:explanatoryNote ofl:OFL_0000003 "A escolha de bfo:Site como categoria de fundamentação resulta de uma eliminação sistemática de alternativas: MaterialEntity falha na persistência quando vazio, Role falha na persistência (requer portador), InformationContentEntity falha nas consultas espaciais, SpatialRegion falha na relatividade à estrutura da planta. Somente Site satisfaz todos os requisitos simultaneamente."@pt-br)
AnnotationAssertion(iof-av:explanatoryNote ofl:OFL_0000003 "The choice of bfo:Site as the grounding category results from a systematic elimination of alternatives: MaterialEntity fails persistence when empty, Role fails persistence (requires bearer), InformationContentEntity fails spatial queries, SpatialRegion fails relativity to plant structure. Only Site satisfies all requirements simultaneously."@en)
AnnotationAssertion(iof-av:firstOrderLogicDefinition ofl:OFL_0000003 "FunctionalLocation(x) → Site(x) ∧ ∃y(MaterialEntity(y) ∧ hasBoundaryDeterminedBy(x,y)) ∧ ¬MaterialArtifact(x)"@en)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000003 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000003 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000003 "A functional location is a site that is a persistent spatial position in an industrial facility hierarchy where a maintainable item is or can be installed, and whose boundaries are determined in relation to delimiting material structures rather than by the equipment that may occupy it."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000003 "Um local de instalação é um sítio que é uma posição espacial persistente em uma hierarquia de instalação industrial onde um item manutenível está ou pode ser instalado, e cujos limites são determinados em relação a estruturas materiais delimitadoras e não pelo equipamento que possa ocupá-lo."@pt-br)
AnnotationAssertion(iof-av:semiFormalNaturalLanguageDefinition ofl:OFL_0000003 "every instance of FunctionalLocation is an instance of bfo:Site that (1) has its boundaries determined by some MaterialEntity, (2) persists independently of whether any Equipment is installed at it, and (3) participates in an ISO 14224 hierarchical decomposition via partOfSystemSite"@en)
AnnotationAssertion(iof-av:synonym ofl:OFL_0000003 "Installation Position"@en)
AnnotationAssertion(iof-av:synonym ofl:OFL_0000003 "Posição de Instalação"@pt-br)
AnnotationAssertion(iof-av:synonym ofl:OFL_0000003 "Tag Location"@en)
AnnotationAssertion(iof-av:usageNote ofl:OFL_0000003 "A functional location persists when empty — when equipment is removed, the inlet/outlet nozzles and foundation bolts remain, so the site boundaries remain anchored."@en)
AnnotationAssertion(iof-av:usageNote ofl:OFL_0000003 "Um local de instalação persiste quando vazio — quando o equipamento é removido, os bocais de entrada/saída e os parafusos de fundação permanecem, então os limites do sítio permanecem ancorados."@pt-br)
SubClassOf(ofl:OFL_0000003 <http://purl.obolibrary.org/obo/BFO_0000029>)
SubClassOf(ofl:OFL_0000003 ObjectSomeValuesFrom(ofl:OFL_0000006 <http://purl.obolibrary.org/obo/BFO_0000040>))

# Class: ofl:OFL_0000004 (Functional Location Code)

AnnotationAssertion(rdfs:label ofl:OFL_0000004 "Código do Local de Instalação"@pt-br)
AnnotationAssertion(rdfs:label ofl:OFL_0000004 "Functional Location Code"@en)
AnnotationAssertion(skos:altLabel ofl:OFL_0000004 "Código LI"@pt-br)
AnnotationAssertion(skos:altLabel ofl:OFL_0000004 "FL Code"@en)
AnnotationAssertion(skos:example ofl:OFL_0000004 "30142.FSGE.FEW.10.01.1"@en)
AnnotationAssertion(skos:example ofl:OFL_0000004 "30234.FSFS.FWSF.10.01.01"@en)
AnnotationAssertion(skos:prefLabel ofl:OFL_0000004 "Código do Local de Instalação"@pt-br)
AnnotationAssertion(skos:prefLabel ofl:OFL_0000004 "Functional Location Code"@en)
AnnotationAssertion(iof-av:adaptedFrom ofl:OFL_0000004 "ISO 14224:2016 — five-level hierarchical coding scheme"@en)
AnnotationAssertion(iof-av:explanatoryNote ofl:OFL_0000004 "Distinct from EquipmentTag: the FL code encodes organizational hierarchy (WHERE in the structure), while the equipment tag encodes functional designation (WHAT type of equipment is expected). Both denote the same functional location."@en)
AnnotationAssertion(iof-av:explanatoryNote ofl:OFL_0000004 "Distinto da Tag de Equipamento: o código LI codifica a hierarquia organizacional (ONDE na estrutura), enquanto a tag de equipamento codifica a designação funcional (QUE tipo de equipamento é esperado). Ambos denotam o mesmo local de instalação."@pt-br)
AnnotationAssertion(iof-av:firstOrderLogicDefinition ofl:OFL_0000004 "FunctionalLocationCode(x) → Identifier(x) ∧ ∃!y(FunctionalLocation(y) ∧ identifies(x,y)) ∧ ¬EquipmentTag(x)"@en)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000004 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000004 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000004 "A functional location code is an identifier that denotes a functional location by encoding the position's place in the ISO 14224 organizational hierarchy, with segments representing plant, system, subsystem, equipment unit, and maintainable item levels."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000004 "Um código de local de instalação é um identificador que denota um local de instalação codificando a posição do local na hierarquia organizacional ISO 14224, com segmentos representando os níveis de planta, sistema, subsistema, unidade de equipamento e item manutenível."@pt-br)
AnnotationAssertion(iof-av:semiFormalNaturalLanguageDefinition ofl:OFL_0000004 "every instance of FunctionalLocationCode is an instance of iao:CentrallyRegisteredIdentifier that identifies exactly one FunctionalLocation and that is disjoint from EquipmentTag"@en)
SubClassOf(ofl:OFL_0000004 <http://purl.obolibrary.org/obo/IAO_0000578>)
SubClassOf(ofl:OFL_0000004 ObjectExactCardinality(1 ofl:OFL_0000014 ofl:OFL_0000003))

# Class: ofl:OFL_0000005 (Functional Location Specification)

AnnotationAssertion(rdfs:label ofl:OFL_0000005 "Especificação do Local de Instalação"@pt-br)
AnnotationAssertion(rdfs:label ofl:OFL_0000005 "Functional Location Specification"@en)
AnnotationAssertion(skos:example ofl:OFL_0000005 "Especificação requerendo função de medição de pressão, faixa 0-350 bar, ATEX Zona 1"@pt-br)
AnnotationAssertion(skos:example ofl:OFL_0000005 "Spec requiring pressure sensing function, range 0-350 bar, ATEX Zone 1"@en)
AnnotationAssertion(skos:prefLabel ofl:OFL_0000005 "Especificação do Local de Instalação"@pt-br)
AnnotationAssertion(skos:prefLabel ofl:OFL_0000005 "Functional Location Specification"@en)
AnnotationAssertion(iof-av:explanatoryNote ofl:OFL_0000005 "Relacionada mas distinta da Tag de Equipamento: duas posições podem compartilhar o mesmo prefixo de tag (ex., ambas XV-) enquanto possuem especificações diferentes (uma classificada para 150 bar, outra para 300 bar). Corresponde a IDO lis:Specified no mapeamento IDO."@pt-br)
AnnotationAssertion(iof-av:explanatoryNote ofl:OFL_0000005 "Related to but distinct from EquipmentTag: two positions may share the same tag prefix (e.g., both XV-) while having different specifications (one rated for 150 bar, another for 300 bar). Corresponds to IDO lis:Specified in the IDO mapping."@en)
AnnotationAssertion(iof-av:firstOrderLogicDefinition ofl:OFL_0000005 "FunctionalLocationSpecification(x) → DirectiveInformationEntity(x) ∧ ∃y(FunctionalLocation(y) ∧ specifiesLocation(x,y)) ∧ ∃z(Function(z) ∧ requiresFunction(x,z))"@en)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000005 "false"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000005 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000005 "A functional location specification is a directive information entity that prescribes the required function and technical constraints (such as pressure ratings, material requirements, and interface dimensions) at a functional location. Specifications persist independently of installed equipment and may evolve over the plant lifecycle."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000005 "Uma especificação de local de instalação é uma entidade informacional diretiva que prescreve a função requerida e as restrições técnicas (tais como classificações de pressão, requisitos de material e dimensões de interface) em um local de instalação. Especificações persistem independentemente do equipamento instalado e podem evoluir ao longo do ciclo de vida da planta."@pt-br)
AnnotationAssertion(iof-av:semiFormalNaturalLanguageDefinition ofl:OFL_0000005 "every instance of FunctionalLocationSpecification is an instance of iao:DirectiveInformationEntity that specifiesLocation some FunctionalLocation and requiresFunction some bfo:Function"@en)
AnnotationAssertion(iof-av:synonym ofl:OFL_0000005 "Especificação LI"@pt-br)
AnnotationAssertion(iof-av:synonym ofl:OFL_0000005 "FL Specification"@en)
SubClassOf(ofl:OFL_0000005 <http://purl.obolibrary.org/obo/IAO_0000033>)
SubClassOf(ofl:OFL_0000005 ObjectSomeValuesFrom(ofl:OFL_0000031 ofl:OFL_0000003))

# Class: ofl:OFL_0000019 (Sítio do Item Manutenível)

AnnotationAssertion(rdfs:label ofl:OFL_0000019 "Maintainable Item Site"@en)
AnnotationAssertion(rdfs:label ofl:OFL_0000019 "Sítio do Item Manutenível"@pt-br)
AnnotationAssertion(skos:example ofl:OFL_0000019 "Site for individual sensor PT-23424"@en)
AnnotationAssertion(skos:example ofl:OFL_0000019 "Sítio para o sensor individual PT-23424"@pt-br)
AnnotationAssertion(iof-av:adaptedFrom ofl:OFL_0000019 "ISO 14224:2016 Level 5: Maintainable Item"@en)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000019 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000019 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000019 "A maintainable item site is a functional location that is the lowest level in the ISO 14224 hierarchy where a single maintainable item is or can be installed."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000019 "Um sítio do item manutenível é um local de instalação que é o nível mais baixo na hierarquia ISO 14224 onde um único item manutenível está ou pode ser instalado."@pt-br)
SubClassOf(ofl:OFL_0000019 ofl:OFL_0000003)
SubClassOf(ofl:OFL_0000019 ObjectSomeValuesFrom(ofl:OFL_0000023 ofl:OFL_0000002))

# Class: ofl:OFL_0000020 (Nota de Manutenção)

AnnotationAssertion(rdfs:label ofl:OFL_0000020 "Maintenance Note"@en)
AnnotationAssertion(rdfs:label ofl:OFL_0000020 "Nota de Manutenção"@pt-br)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000020 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000020 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000020 "A maintenance note is a data item that is a textual record created during maintenance work, anchored to a functional location rather than to equipment for persistence across replacements."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000020 "Uma nota de manutenção é um item de dado que é um registro textual criado durante trabalho de manutenção, ancorado a um local de instalação ao invés de ao equipamento para persistência através de substituições."@pt-br)
SubClassOf(ofl:OFL_0000020 <http://purl.obolibrary.org/obo/IAO_0000100>)

# Class: ofl:OFL_0000025 (Plant Site)

AnnotationAssertion(rdfs:label ofl:OFL_0000025 "Plant Site"@en)
AnnotationAssertion(rdfs:label ofl:OFL_0000025 "Sítio da Planta"@pt-br)
AnnotationAssertion(skos:example ofl:OFL_0000025 "Offshore platform P-74"@en)
AnnotationAssertion(skos:example ofl:OFL_0000025 "Plataforma offshore P-74"@pt-br)
AnnotationAssertion(iof-av:adaptedFrom ofl:OFL_0000025 "ISO 14224:2016 Level 1: Plant"@en)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000025 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000025 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000025 "A plant site is a functional location that is the highest level in the ISO 14224 hierarchy, representing an entire industrial plant or facility."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000025 "Um sítio da planta é um local de instalação que é o nível mais alto na hierarquia ISO 14224, representando uma planta ou instalação industrial inteira."@pt-br)
SubClassOf(ofl:OFL_0000025 ofl:OFL_0000003)

# Class: ofl:OFL_0000027 (Papel Requerido)

AnnotationAssertion(rdfs:label ofl:OFL_0000027 "Papel Requerido"@pt-br)
AnnotationAssertion(rdfs:label ofl:OFL_0000027 "Required Role"@en)
AnnotationAssertion(skos:example ofl:OFL_0000027 "Papel de estrangulamento variável, papel de controle de alta pressão"@pt-br)
AnnotationAssertion(skos:example ofl:OFL_0000027 "Variable choking role, high-pressure control role"@en)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000027 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000027 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000027 "A required role is a BFO role that specifies the functional requirements for equipment at a functional location."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000027 "Um papel requerido é um papel BFO que especifica os requisitos funcionais para equipamento em um local de instalação."@pt-br)
SubClassOf(ofl:OFL_0000027 <http://purl.obolibrary.org/obo/BFO_0000023>)

# Class: ofl:OFL_0000030 (Sensor)

AnnotationAssertion(rdfs:label ofl:OFL_0000030 "Sensor"@en)
AnnotationAssertion(rdfs:label ofl:OFL_0000030 "Sensor"@pt-br)
AnnotationAssertion(skos:example ofl:OFL_0000030 "Pressure sensor installed at position PT-23424"@en)
AnnotationAssertion(skos:example ofl:OFL_0000030 "Sensor de pressão instalado na posição PT-23424"@pt-br)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000030 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000030 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000030 "A sensor is an equipment item that measures physical properties such as pressure, temperature, or flow."@en)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000030 "Um sensor é um item de equipamento que mede propriedades físicas tais como pressão, temperatura ou vazão."@pt-br)
SubClassOf(ofl:OFL_0000030 iof-constr:MaterialArtifact)

# Class: ofl:OFL_0000033 (Subsystem Site)

AnnotationAssertion(rdfs:label ofl:OFL_0000033 "Subsystem Site"@en)
AnnotationAssertion(rdfs:label ofl:OFL_0000033 "Sítio do Subsistema"@pt-br)
AnnotationAssertion(skos:example ofl:OFL_0000033 "Inlet Separator subsystem site within Gas Dehydration System"@en)
AnnotationAssertion(iof-av:adaptedFrom ofl:OFL_0000033 "ISO 14224:2016 Level 3: Subsystem"@en)
AnnotationAssertion(iof-av:isPrimitive ofl:OFL_0000033 "true"^^xsd:boolean)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000033 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000033 "A subsystem site is a functional location that represents a subsystem within a system in the ISO 14224 hierarchy."@en)
