AnnotationAssertion(rdfs:label ofl:OFL_0000021 "texto da nota"@pt-br)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000021 iof-ind:Provisional)
DataPropertyDomain(ofl:OFL_0000021 ofl:OFL_0000020)
DataPropertyRange(ofl:OFL_0000021 xsd:string)

# Data Property: ofl:OFL_0000022 (note timestamp)

AnnotationAssertion(rdfs:label ofl:OFL_0000022 "carimbo de tempo da nota"@pt-br)
AnnotationAssertion(rdfs:label ofl:OFL_0000022 "note timestamp"@en)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000022 iof-ind:Provisional)
FunctionalDataProperty(ofl:OFL_0000022)
DataPropertyDomain(ofl:OFL_0000022 ofl:OFL_0000020)
DataPropertyRange(ofl:OFL_0000022 xsd:dateTime)

# Data Property: ofl:OFL_0000026 (data de remoção)

AnnotationAssertion(rdfs:label ofl:OFL_0000026 "data de remoção"@pt-br)
AnnotationAssertion(rdfs:label ofl:OFL_0000026 "removed date"@en)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000026 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000026 "O carimbo de tempo de quando o equipamento foi removido de um local de instalação. A ausência indica que o equipamento está atualmente instalado."@pt-br)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000026 "The timestamp when equipment was removed from a functional location. Absence indicates equipment is currently installed."@en)
FunctionalDataProperty(ofl:OFL_0000026)
DataPropertyDomain(ofl:OFL_0000026 iof-constr:MaterialArtifact)
DataPropertyRange(ofl:OFL_0000026 xsd:dateTime)

