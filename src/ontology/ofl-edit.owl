AnnotationAssertion(rdfs:label ofl:OFL_0000010 "tem rótulo da série"@pt-br)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000010 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000010 "A user-facing label for a time series dataset."@en)
FunctionalDataProperty(ofl:OFL_0000010)
DataPropertyDomain(ofl:OFL_0000010 ofl:OFL_0000035)
DataPropertyRange(ofl:OFL_0000010 xsd:string)

# Data Property: ofl:OFL_0000018 (data de instalação)

AnnotationAssertion(rdfs:label ofl:OFL_0000018 "data de instalação"@pt-br)
AnnotationAssertion(rdfs:label ofl:OFL_0000018 "installed date"@en)
AnnotationAssertion(iof-av:maturity ofl:OFL_0000018 iof-ind:Provisional)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000018 "O carimbo de tempo de quando o equipamento foi instalado em um local de instalação."@pt-br)
AnnotationAssertion(iof-av:naturalLanguageDefinition ofl:OFL_0000018 "The timestamp when equipment was installed at a functional location."@en)
FunctionalDataProperty(ofl:OFL_0000018)
DataPropertyDomain(ofl:OFL_0000018 iof-constr:MaterialArtifact)
DataPropertyRange(ofl:OFL_0000018 xsd:dateTime)

