Prefix(iof-ind:=<https://spec.industrialontologies.org/ontology/individual/>)
Prefix(iof-constr:=<https://spec.industrialontologies.org/ontology/construct/>)


Ontology(<https://www.inf.ufrgs.br/ontologies/ofl.owl>

Import(<https://www.inf.ufrgs.br/ontologies/ofl/imports/bfo_import.owl>)
Import(<https://www.inf.ufrgs.br/ontologies/ofl/imports/iao_import.owl>)
Import(<https://www.inf.ufrgs.br/ontologies/ofl/imports/iof-core_import.owl>)


Annotation(dcterms:contributor "Cauã Antunes"@en)
Annotation(dcterms:contributor "Joel Carbonera"@en)
Annotation(dcterms:contributor "Haroldo Rojas"@en)
Annotation(dcterms:contributor "Mara Abel"@en)
Annotation(dcterms:contributor "Rafael Petry"@en)
Annotation(dcterms:contributor "Regis Romeu"@en)
Annotation(dcterms:created "2025-12-17"^^xsd:date)
Annotation(dcterms:creator "Nicolau Santos"@en)
Annotation(dcterms:description "A BFO-compliant ontology for modeling functional locations as persistent spatial sites in industrial asset management systems, based on the Ontology Design Pattern developed by Santos et al. (2026). The pattern separates five concerns: spatial site (bfo:Site), organizational code (iao:CentrallyRegisteredIdentifier), equipment tag (iao:CentrallyRegisteredIdentifier), functional specification (iao:DirectiveInformationEntity), and installed equipment (iof:MaterialArtifact). Both identifiers denote the functional location site, not the physical equipment — the relationship to equipment is always mediated through the site."@en)
Annotation(dcterms:description "Uma ontologia em conformidade com a BFO para modelar locais de instalação como sítios espaciais persistentes em sistemas de gestão de ativos industriais, baseada no padrão de projeto ontológico desenvolvido por Santos et al. (2026). O padrão separa cinco preocupações: sítio espacial (bfo:Site), código do local de instalação (iao:CentrallyRegisteredIdentifier), tag de equipamento (iao:CentrallyRegisteredIdentifier), especificação funcional (iao:DirectiveInformationEntity) e equipamento instalado (iof:MaterialArtifact). Ambos os identificadores denotam o local de instalação, não o equipamento físico — a relação com o equipamento é sempre mediada pelo sítio."@pt-br)
Annotation(dcterms:license <http://opensource.org/licenses/MIT>)
Annotation(dcterms:modified "2026-07-01"^^xsd:date)
Annotation(dcterms:subject "Functional Location"@en)
Annotation(dcterms:subject "Gestão de Ativos Industriais"@pt-br)
Annotation(dcterms:subject "ISO 14224"@en)
Annotation(dcterms:subject "Industrial Asset Management"@en)
Annotation(dcterms:subject "Local de Instalação"@pt-br)
Annotation(dcterms:title "Ontology of Functional Locations"@en)
Annotation(dcterms:title "Ontologia de Locais de Instalação"@pt-br)


Declaration(AnnotationProperty(dcterms:description))
Declaration(AnnotationProperty(dcterms:license))
Declaration(AnnotationProperty(dcterms:title))
