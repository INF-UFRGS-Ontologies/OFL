@prefix : <https://www.inf.ufrgs.br/ontologies/ofl/ofl-simple.ttl#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix terms: <http://purl.org/dc/terms/> .
@prefix annotation: <https://spec.industrialontologies.org/ontology/annotation/> .
@base <https://www.inf.ufrgs.br/ontologies/ofl/ofl-simple.ttl> .

<https://www.inf.ufrgs.br/ontologies/ofl/ofl-simple.ttl> rdf:type owl:Ontology ;
                                                          owl:versionIRI <https://www.inf.ufrgs.br/ontologies/ofl/releases/2026-11-10/ofl-simple.ttl> ;
                                                          terms:contributor "Cauã Antunes"@en ,
                                                                            "Haroldo Rojas"@en ,
                                                                            "Joel Carbonera"@en ,
                                                                            "Mara Abel"@en ,
                                                                            "Rafael Petry"@en ,
                                                                            "Regis Romeu"@en ;
                                                          terms:created "2025-12-17"^^xsd:date ;
                                                          terms:creator "Nicolau Santos"@en ;
                                                          terms:description "A BFO-compliant ontology for modeling functional locations as persistent spatial sites in industrial asset management systems, based on the Ontology Design Pattern developed by Santos et al. (2026). The pattern separates five concerns: spatial site (bfo:Site), organizational code (iao:CentrallyRegisteredIdentifier), equipment tag (iao:CentrallyRegisteredIdentifier), functional specification (iao:DirectiveInformationEntity), and installed equipment (iof:MaterialArtifact). Both identifiers denote the functional location site, not the physical equipment — the relationship to equipment is always mediated through the site."@en ,
                                                                            "Uma ontologia em conformidade com a BFO para modelar locais de instalação como sítios espaciais persistentes em sistemas de gestão de ativos industriais, baseada no padrão de projeto ontológico desenvolvido por Santos et al. (2026). O padrão separa cinco preocupações: sítio espacial (bfo:Site), código do local de instalação (iao:CentrallyRegisteredIdentifier), tag de equipamento (iao:CentrallyRegisteredIdentifier), especificação funcional (iao:DirectiveInformationEntity) e equipamento instalado (iof:MaterialArtifact). Ambos os identificadores denotam o local de instalação, não o equipamento físico — a relação com o equipamento é sempre mediada pelo sítio."@pt-br ;
                                                          terms:license <http://opensource.org/licenses/MIT> ;
                                                          terms:modified "2026-07-01"^^xsd:date ;
                                                          terms:subject "Functional Location"@en ,
                                                                        "Gestão de Ativos Industriais"@pt-br ,
                                                                        "ISO 14224"@en ,
                                                                        "Industrial Asset Management"@en ,
                                                                        "Local de Instalação"@pt-br ;
                                                          terms:title "Ontologia de Locais de Instalação"@pt-br ,
                                                                      "Ontology of Functional Locations"@en ;
                                                          owl:versionInfo "2026-11-10" .

